    "qemu",
    "kvm",
    "virtualization",
    "management"
  ],
  "author": "Hopingboyz",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bytenode": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "ejs": "^6.0.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "postject": "^1.0.0-alpha.6",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.6",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.2",
    "ws": "^8.14.2",
    "discord.js": "^14.14.1"
  },
  "devDependencies": {
    "javascript-obfuscator": "^5.5.1",
    "nodemon": "^3.0.1",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": [
      "app.js",
      "licenses.js"
    ],
    "assets": [
      "public/**/*",
      "views/**/*"
    ]
