{
  "name": "hopingboyz-vm-manager",
  "version": "1.0.0",
  "description": "Web-based VM Management Panel powered by Hopingboyz",
  "main": "app.js",
  "bin": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "pkg app.js -t node16-linux-x64 -o hopingboyz-vm-manager.bin"
  },
  "keywords": [
