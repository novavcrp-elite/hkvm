# ============= HKVM Panel Configuration =============
# Copy this file to .env and fill in values

# Server
PORT=8080
PANEL_VERSION=V1.0
HKVM_DATA_DIR=

# Panel Identity
PANEL_NAME=HKVM Panel
DEFAULT_LOGO_URL=https://i.imgur.com/0DmkSi4.png

# ============= Discord Bot =============
# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Comma-separated Discord user IDs allowed to use admin commands
# Example: 123456789012345678,987654321098765432
DISCORD_ADMIN_IDS=

# Secret for generating Discord linking codes (change to a random string)
DISCORD_LINK_SECRET=change-this-to-a-random-secret-string

# ============= Internal API =============
# Secret key for internal API authentication (used by Discord bot)
INTERNAL_API_SECRET=change-this-to-a-random-secret-string

# ============= NoVNC =============
# Base URL for NoVNC WebSocket proxy (e.g., http://your-panel:8080)
NOVNC_BASE_URL=

# ============= tmate =============
# Timeout for tmate sessions in seconds (default: 3600 = 1 hour)
TMATE_SESSION_TIMEOUT=3600

# ============= Security =============
# Session secret for express-session
SESSION_SECRET=hopingboyz-secret-key-change-in-production
