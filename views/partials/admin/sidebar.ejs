<%
  const cp = currentPage || '';
  const u = user || {};
%>

<!-- Sidebar Overlay for Mobile -->
<link rel="stylesheet" href="/css/admin.css">
<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- Admin Sidebar -->
<aside class="admin-sidebar" id="adminSidebar">

  <!-- Brand -->
  <a href="/admin/dashboard" class="sidebar-brand">
    <div class="sidebar-brand-icon" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-md); overflow: hidden; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <img src="<%= siteLogo %>" style="width: 100%; height: 100%; border-radius: var(--radius-md); object-fit: cover; padding: 2px;" alt="<%= siteName %> Logo">
    </div>
    <div class="sidebar-brand-text">
      <div class="sidebar-brand-name"><%= siteName %></div>
      <div class="sidebar-brand-version"><%= panelVersion %> • HKVM PANEL</div>
    </div>
  </a>

  <!-- Navigation -->
  <nav class="sidebar-nav">

    <!-- Core -->
    <div class="nav-section">
      <div class="nav-section-label">Overview</div>

      <a href="/admin/dashboard" class="nav-item <%= cp === 'dashboard' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="9" rx="1"></rect>
            <rect x="14" y="3" width="7" height="5" rx="1"></rect>
            <rect x="14" y="12" width="7" height="9" rx="1"></rect>
            <rect x="3" y="16" width="7" height="5" rx="1"></rect>
          </svg>
        </span>
        <span class="nav-text">Dashboard</span>
        <span class="nav-badge" id="runningBadge" style="display:none">0</span>
      </a>
      
      <a href="/dashboard" class="nav-item nav-item-highlight">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
        </span>
        <span class="nav-text">Back to User Panel</span>
      </a>
    </div>

    <!-- Virtual Machines -->
    <div class="nav-section">
      <div class="nav-section-label">Virtual Machines</div>

      <a href="/admin/vms" class="nav-item <%= cp === 'vms' || cp === 'vm-detail' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M8 20h8"></path>
            <path d="M12 16v4"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </span>
        <span class="nav-text">All VMs</span>
        <span class="nav-badge" id="vmCountBadge" style="display:none">0</span>
      </a>

      <% if (u.role === 'admin') { %>
      <a href="/admin/vm-create" class="nav-item <%= cp === 'vm-create' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
        </span>
        <span class="nav-text">Create VM</span>
      </a>
      <% } %>
    </div>

    <!-- Management -->
    <% if (u.role === 'admin') { %>
    <div class="nav-section">
      <div class="nav-section-label">Management</div>

      <a href="/admin/users" class="nav-item <%= cp === 'users' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </span>
        <span class="nav-text">Users</span>
      </a>

      <a href="/admin/settings" class="nav-item <%= cp === 'settings' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
        </span>
        <span class="nav-text">Settings</span>
      </a>

      <a href="/admin/nodes" class="nav-item <%= cp === 'nodes' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>
        </span>
        <span class="nav-text">Nodes</span>
      </a>

      <a href="/admin/templates" class="nav-item <%= cp === 'templates' ? 'active' : '' %>">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
        </span>
        <span class="nav-text">OS Templates</span>
      </a>
    </div>
    <% } %>

    <!-- Tools -->
    <div class="nav-section">
      <div class="nav-section-label">Tools</div>

      <div class="nav-item" onclick="openQuickActions()">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
        </span>
        <span class="nav-text">Quick Actions</span>
      </div>

      <div class="nav-item" onclick="openSystemInfo()">
        <span class="nav-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="16" x2="12" y2="12"></line>
            <line x1="12" y1="8" x2="12.01" y2="8"></line>
          </svg>
        </span>
        <span class="nav-text">System Info</span>
      </div>
    </div>

  </nav>

  <!-- Sidebar Footer -->
  <div class="sidebar-footer">

    <!-- User Info -->
    <div class="sidebar-user" onclick="toggleDropdown('sidebarUserMenu')">
      <div class="user-avatar">
        <%= u.username ? u.username.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div class="user-info">
        <div class="user-name"><%= u.username || 'Admin' %></div>
        <div class="user-role">
          <% if (u.role === 'admin') { %>
          <span style="display: inline-flex; align-items: center; gap: 4px;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.6-6.3 4.6L8 13.8l-6-4.6h7.6z"/></svg>
            Administrator
          </span>
          <% } else { %>
          <span style="display: inline-flex; align-items: center; gap: 4px;">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            User
          </span>
          <% } %>
        </div>
      </div>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-muted); flex-shrink:0;">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>

    <!-- Sidebar User Dropdown -->
    <div class="dropdown-menu" id="sidebarUserMenu" style="bottom: 100%; top: auto; margin-bottom: 6px; right: 0; left: 0; min-width: unset;">
      <a href="/admin/settings" class="dropdown-item">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3"></circle>
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
        </svg>
        Profile & Settings
      </a>
      <div class="dropdown-divider"></div>
      <button class="dropdown-item danger" onclick="logout()">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Sign Out
      </button>
    </div>
  </div>
</aside>

<!-- Quick Actions Modal -->
<div class="modal-overlay" id="quickActionsModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
          <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
        </svg>
        Quick Actions
      </div>
      <button class="modal-close" onclick="closeModal('quickActionsModal')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <a href="/admin/vm-create" class="btn btn-primary btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
          Create VM
        </a>
        <a href="/admin/vms" class="btn btn-outline btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <path d="M8 20h8"></path>
            <path d="M12 16v4"></path>
          </svg>
          View All VMs
        </a>
        <% if (u.role === 'admin') { %>
        <a href="/admin/users" class="btn btn-ghost btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
          </svg>
          Manage Users
        </a>
        <a href="/admin/settings" class="btn btn-ghost btn-lg" style="justify-content: center;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
          </svg>
          Settings
        </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- System Info Modal -->
<div class="modal-overlay" id="systemInfoModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        System Information
      </div>
      <button class="modal-close" onclick="closeModal('systemInfoModal')">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="modal-body">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;" id="systemInfoGrid">
        <div class="card" style="padding: 14px;">
          <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.5px;">Panel Version</div>
          <div style="font-size: 16px; font-weight: 700; color: var(--accent-primary);">v<%= panelVersion %></div>
        </div>
        <div class="card" style="padding: 14px;">
          <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.5px;">Status</div>
          <div style="font-size: 16px; font-weight: 700; color: var(--accent-green); display: flex; align-items: center;">
            <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; margin-right: 6px;"></span>
            Online
          </div>
        </div>
        <div class="card" style="padding: 14px;">
          <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.5px;">Platform</div>
          <div style="font-size: 14px; font-weight: 600; color: var(--text-primary);">QEMU/KVM</div>
        </div>
        <div class="card" style="padding: 14px;">
          <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; letter-spacing: 0.5px;">Engine</div>
          <div style="font-size: 14px; font-weight: 600; color: var(--text-primary);">Express + EJS</div>
        </div>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('systemInfoModal')">Close</button>
    </div>
  </div>
</div>

<script>
// Sidebar functionality
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  sidebar.classList.toggle('open');
  overlay.classList.toggle('open');
  document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
}

function closeSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  sidebar.classList.remove('open');
  overlay.classList.remove('open');
  document.body.style.overflow = '';
}

// Modal functions
function openModal(id) {
  document.getElementById(id).classList.add('show');
  document.body.style.overflow = 'hidden';
}

function closeModal(id) {
  document.getElementById(id).classList.remove('show');
  document.body.style.overflow = '';
}

function openQuickActions() { openModal('quickActionsModal'); }
function openSystemInfo() { openModal('systemInfoModal'); }

// Close modal on overlay click
document.addEventListener('click', (e) => {
  if (e.target.classList.contains('modal-overlay')) {
    document.querySelectorAll('.modal-overlay').forEach(m => {
      m.classList.remove('show');
    });
    document.body.style.overflow = '';
  }
});

// Load sidebar stats
async function loadSidebarStats() {
  try {
    const [vmsRes, settingsRes] = await Promise.all([
      fetch('/api/vms'),
      fetch('/api/settings')
    ]);
    
    if (vmsRes.ok) {
      const vms = await vmsRes.json();
      const runningCount = vms.filter(vm => vm.status === 'running').length;
      const vmCountBadge = document.getElementById('vmCountBadge');
      const runningBadge = document.getElementById('runningBadge');
      
      if (vmCountBadge) {
        vmCountBadge.textContent = vms.length;
        vmCountBadge.style.display = 'inline-flex';
      }
      
      if (runningBadge) {
        runningBadge.textContent = runningCount;
        runningBadge.style.display = runningCount > 0 ? 'inline-flex' : 'none';
      }
    }
    
    if (settingsRes.ok) {
      const settings = await settingsRes.json();
      const siteName = settings['site_name'] || '<%= siteName %>';
      const nameEl = document.getElementById('sidebarName');
      if (nameEl) {
        nameEl.textContent = siteName;
      }
    }
  } catch(e) {
    console.error('Failed to load sidebar data:', e);
  }
}

// Load sidebar data on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', loadSidebarStats);
} else {
  loadSidebarStats();
}

// Refresh stats every 30 seconds
setInterval(loadSidebarStats, 30000);
</script>