<%
  // Determine active state for breadcrumb
  const pageTitle = title || 'HKVM Panel';
  const pageName = currentPage || '';
%>
<header class="admin-header" id="adminHeader">
  <!-- Left: Toggle + Breadcrumb -->
  <div class="header-left">
    <button class="sidebar-toggle" id="sidebarToggle" onclick="toggleSidebar()" aria-label="Toggle sidebar">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <nav class="breadcrumb" aria-label="Breadcrumb">
      <span class="breadcrumb-item">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
        </svg>
      </span>
      <span class="breadcrumb-separator">›</span>
      <span class="breadcrumb-item">HKVM</span>
      <% if (pageName && pageName !== 'dashboard') { %>
      <span class="breadcrumb-separator">›</span>
      <span class="breadcrumb-item active"><%= pageTitle.split(' - ')[0] %></span>
      <% } else { %>
      <span class="breadcrumb-separator">›</span>
      <span class="breadcrumb-item active">Dashboard</span>
      <% } %>
    </nav>
  </div>

  <!-- Center: Search -->
  <div class="header-search">
    <div class="search-input-wrapper">
      <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input type="text" class="search-input" id="globalSearch" placeholder="Search VMs, users..." autocomplete="off">
    </div>
  </div>

  <!-- Right: Actions + User -->
  <div class="header-right">
    <!-- System Status Indicator -->
    <div class="header-status" id="systemStatus">
      <span class="status-dot"></span>
      <span>Online</span>
    </div>

    <!-- Theme Switcher -->
    <div class="theme-switcher" title="Switch Theme">
      <button class="theme-btn active" id="darkThemeBtn" onclick="setTheme('dark')" title="Dark Theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>
      <button class="theme-btn" id="lightThemeBtn" onclick="setTheme('light')" title="Light Theme">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
      </button>
    </div>

    <!-- Notifications -->
    <div class="dropdown">
      <button class="header-btn" id="notifBtn" onclick="toggleDropdown('notifMenu')" title="Notifications">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 01-3.46 0"></path>
        </svg>
        <span class="notification-dot" id="notifDot" style="display:none"></span>
      </button>
      <div class="dropdown-menu" id="notifMenu">
        <div style="padding: 12px 14px; border-bottom: 1px solid var(--border-subtle);">
          <div style="font-size: 13px; font-weight: 600; color: var(--text-primary);">Notifications</div>
        </div>
        <div id="notifList" style="max-height: 280px; overflow-y: auto;">
          <div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 12px;">
            <div style="font-size: 28px; margin-bottom: 8px;">🔔</div>
            No new notifications
          </div>
        </div>
      </div>
    </div>

    <!-- Fullscreen -->
    <button class="header-btn" onclick="toggleFullscreen()" title="Toggle fullscreen">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" id="fsIcon">
        <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"></path>
      </svg>
    </button>

    <!-- User Menu -->
    <div class="dropdown">
      <div class="header-user" id="userMenuBtn" onclick="toggleDropdown('userMenu')">
        <div class="header-user-avatar" id="headerAvatar">
          <%= (user && user.username) ? user.username.charAt(0).toUpperCase() : 'A' %>
        </div>
        <span class="header-user-name" id="headerUsername">
          <%= (user && user.username) ? user.username : 'Admin' %>
        </span>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-muted);">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
      <div class="dropdown-menu" id="userMenu" style="min-width: 200px;">
        <div style="padding: 12px 14px; border-bottom: 1px solid var(--border-subtle);">
          <div style="font-size: 13px; font-weight: 600; color: var(--text-primary);" id="menuUsername">
            <%= (user && user.username) ? user.username : 'Admin' %>
          </div>
          <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;" id="menuRole">
            <%= (user && user.role) ? user.role.charAt(0).toUpperCase() + user.role.slice(1) : 'Administrator' %>
          </div>
        </div>
        <a href="/admin/settings" class="dropdown-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M19.07 4.93l-1.41 1.41M4.93 19.07l-1.41 1.41M20 12h-2M6 12H4m13.66 5.66l-1.41-1.41M6.75 6.75L5.34 5.34"></path>
          </svg>
          Settings
        </a>
        <div class="dropdown-divider"></div>
        <button class="dropdown-item danger" onclick="logout()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
          Sign Out
        </button>
      </div>
    </div>
  </div>
</header>

<!-- Search Results Dropdown -->
<div id="searchResults" style="
  display: none;
  position: fixed;
  top: calc(var(--header-height) + 8px);
  left: 50%;
  transform: translateX(-50%);
  width: 400px;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-xl);
  z-index: 200;
  max-height: 320px;
  overflow-y: auto;
"></div>

<script>
// Theme Management
function setTheme(theme) {
  const body = document.body;
  const darkBtn = document.getElementById('darkThemeBtn');
  const lightBtn = document.getElementById('lightThemeBtn');
  
  if (theme === 'dark') {
    body.classList.remove('light-theme');
    darkBtn?.classList.add('active');
    lightBtn?.classList.remove('active');
    localStorage.setItem('theme', 'dark');
  } else if (theme === 'light') {
    body.classList.add('light-theme');
    darkBtn?.classList.remove('active');
    lightBtn?.classList.add('active');
    localStorage.setItem('theme', 'light');
  }
}

// Initialize theme on page load
function initializeTheme() {
  const savedTheme = localStorage.getItem('theme') || 'dark';
  setTheme(savedTheme);
}

// Global search
let searchTimer;
const searchInput = document.getElementById('globalSearch');
if (searchInput) {
  searchInput.addEventListener('input', function() {
    clearTimeout(searchTimer);
    const q = this.value.trim();
    if (q.length < 2) {
      document.getElementById('searchResults').style.display = 'none';
      return;
    }
    searchTimer = setTimeout(() => performSearch(q), 300);
  });
  searchInput.addEventListener('blur', () => {
    setTimeout(() => { document.getElementById('searchResults').style.display = 'none'; }, 200);
  });
}

async function performSearch(query) {
  try {
    const res = await fetch('/api/vms');
    if (!res.ok) return;
    const vms = await res.json();
    const q = query.toLowerCase();
    const results = vms.filter(vm => 
      vm.vm_name?.toLowerCase().includes(q) || 
      vm.os_type?.toLowerCase().includes(q) ||
      String(vm.vm_id).includes(q)
    ).slice(0, 6);
    
    const el = document.getElementById('searchResults');
    if (results.length === 0) {
      el.innerHTML = `<div style="padding: 20px; text-align: center; color: var(--text-muted); font-size: 13px;">No results for "${query}"</div>`;
    } else {
      el.innerHTML = results.map(vm => {
        const icon = vm.template_icon;
        const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
        return `
        <a href="/admin/vm/${vm.vm_id}" style="display:flex; align-items:center; gap:10px; padding:10px 14px; text-decoration:none; color:var(--text-secondary); border-bottom:1px solid var(--border-subtle); transition:background 0.15s;">
          <img src="${displayIcon}" style="width:20px; height:20px; object-fit:cover; border-radius:3px;" onerror="this.style.fontSize='18px'; this.style.width='auto'; this.style.height='auto'; this.textContent='⚫';">
          <div>
            <div style="font-size:13px; font-weight:600; color:var(--text-primary);">${vm.vm_name}</div>
            <div style="font-size:11px; color:var(--text-muted);">ID: ${vm.vm_id} · ${vm.template_name || vm.os_type || 'Unknown OS'}</div>
          </div>
          <span style="margin-left:auto; font-size:11px; color:${vm.status === 'running' ? 'var(--accent-green)' : 'var(--text-muted)'};">${vm.status}</span>
        </a>
      `;
      }).join('');
    }
    el.style.display = 'block';
  } catch(e) {}
}

// Fullscreen toggle
function toggleFullscreen() {
  if (!document.fullscreenElement) {
    document.documentElement.requestFullscreen();
    document.getElementById('fsIcon').innerHTML = `
      <path d="M8 3v3a2 2 0 01-2 2H3m18 0h-3a2 2 0 01-2-2V3m0 18v-3a2 2 0 012-2h3M3 16h3a2 2 0 012 2v3"></path>
    `;
  } else {
    document.exitFullscreen();
    document.getElementById('fsIcon').innerHTML = `
      <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"></path>
    `;
  }
}

// Logout
async function logout() {
  try {
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/login';
  } catch(e) {
    window.location.href = '/login';
  }
}

// Dropdown toggle
function toggleDropdown(id) {
  const menu = document.getElementById(id);
  const allMenus = document.querySelectorAll('.dropdown-menu');
  allMenus.forEach(m => { if (m.id !== id) m.classList.remove('show'); });
  menu.classList.toggle('show');
}

// Sidebar toggle for mobile
function toggleSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  
  if (sidebar) {
    sidebar.classList.toggle('show');
  }
  if (overlay) {
    overlay.classList.toggle('show');
  }
}

// Close sidebar helper
function closeSidebar() {
  const sidebar = document.getElementById('adminSidebar');
  const overlay = document.getElementById('sidebarOverlay');
  
  if (sidebar) {
    sidebar.classList.remove('show');
  }
  if (overlay) {
    overlay.classList.remove('show');
  }
}

// Close sidebar when clicking overlay
document.addEventListener('DOMContentLoaded', () => {
  const overlay = document.getElementById('sidebarOverlay');
  if (overlay) {
    overlay.addEventListener('click', closeSidebar);
  }
});

// Close dropdowns on outside click
document.addEventListener('click', (e) => {
  if (!e.target.closest('.dropdown')) {
    document.querySelectorAll('.dropdown-menu').forEach(m => m.classList.remove('show'));
  }
});

// Initialize theme on page load
document.addEventListener('DOMContentLoaded', initializeTheme);
</script>



