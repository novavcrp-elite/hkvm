<link rel="stylesheet" href="/css/admin.css">
<aside class="admin-sidebar" id="adminSidebar">
    
    <!-- Brand -->
    <a href="/dashboard" class="sidebar-brand">
        <div class="sidebar-brand-icon" style="display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: var(--radius-md); overflow: hidden; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
          <img src="<%= siteLogo %>" style="width: 100%; height: 100%; border-radius: var(--radius-md); object-fit: cover; padding: 2px;" alt="<%= siteName %> Logo">
        </div>
        <div class="sidebar-brand-text">
            <div class="sidebar-brand-name" id="userSidebarName"><%= siteName %></div>
            <div class="sidebar-brand-version"><%= panelVersion %> User</div>
        </div>
    </a>
    
    <nav class="sidebar-nav">
        <div class="nav-section">
            <div class="nav-section-label">Menu</div>
            
            <a href="/dashboard" class="nav-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="9" rx="1"></rect>
                        <rect x="14" y="3" width="7" height="5" rx="1"></rect>
                        <rect x="14" y="12" width="7" height="9" rx="1"></rect>
                        <rect x="3" y="16" width="7" height="5" rx="1"></rect>
                    </svg>
                </span>
                <span class="nav-text">Dashboard</span>
            </a>
            
            <a href="/vms" class="nav-item <%= currentPage === 'vms' ? 'active' : '' %>">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                        <path d="M8 20h8"></path>
                        <path d="M12 16v4"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                    </svg>
                </span>
                <span class="nav-text">My Virtual Machines</span>
            </a>
            
            <div class="nav-item has-children" onclick="toggleSubmenu(this)">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                        <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                        <line x1="6" y1="6" x2="6.01" y2="6"></line>
                        <line x1="6" y1="18" x2="6.01" y2="18"></line>
                    </svg>
                </span>
                <span class="nav-text">LXC Containers</span>
                <svg class="nav-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
            </div>
            <div class="nav-submenu <%= currentPage === 'lxc' || currentPage === 'lxc-detail' || currentPage === 'lxc-create' ? 'open' : '' %>">
                <a href="/lxc" class="nav-subitem <%= currentPage === 'lxc' || currentPage === 'lxc-detail' ? 'active' : '' %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                    All Containers
                </a>
                <a href="/lxc/create" class="nav-subitem <%= currentPage === 'lxc-create' ? 'active' : '' %>">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                    Create Container
                </a>
            </div>
            
            <a href="/profile" class="nav-item <%= currentPage === 'profile' ? 'active' : '' %>">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </span>
                <span class="nav-text">My Profile</span>
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-label">Integration</div>
        

            <a href="/discord/link" class="nav-item <%= currentPage === 'discord-link' ? 'active' : '' %>">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                    </svg>
                </span>
                <span class="nav-text">Link Discord</span>
            </a>
        </div>


        <!-- Admin Section (shown only to admins) -->
        <% if (user && user.role === 'admin') { %>
        <div class="nav-section">
            <div class="nav-section-label">Administration</div>
            
            <a href="/admin/dashboard" class="nav-item nav-item-highlight">
                <span class="nav-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 15a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"></path>
                        <path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"></path>
                    </svg>
                </span>
                <span class="nav-text">Admin Panel</span>
                <span class="nav-badge nav-badge-admin">ADMIN</span>
            </a>
        </div>
        <% } %>
    </nav>
    
    <div class="sidebar-footer">
        <div class="sidebar-user" onclick="toggleDropdown('userSidebarMenu')">
            <div class="user-avatar">
                <%= user ? user.username.charAt(0).toUpperCase() : 'U' %>
            </div>
            <div class="user-info">
                <div class="user-name"><%= user ? user.username : 'Guest' %></div>
                <div class="user-role">
                    <span style="display: inline-flex; align-items: center; gap: 4px;">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                        User
                    </span>
                </div>
            </div>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--text-muted); flex-shrink:0;">
                <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
        </div>

        <div class="dropdown-menu" id="userSidebarMenu" style="bottom: 100%; top: auto; margin-bottom: 6px; right: 0; left: 0; min-width: unset;">
            <button class="dropdown-item danger" onclick="userLogout()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Sign Out
            </button>
        </div>
    </div>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<style>
    .nav-item.has-children { cursor: pointer; }
    .nav-arrow { margin-left: auto; transition: transform 0.2s; color: var(--text-muted); flex-shrink: 0; }
    .nav-item.has-children:hover .nav-arrow { color: var(--text-primary); }
    .nav-submenu { display: none; padding-left: 20px; }
    .nav-submenu.open { display: block; }
    .nav-subitem { display: flex; align-items: center; gap: 8px; padding: 7px 12px; font-size: 13px; color: var(--text-secondary); text-decoration: none; border-radius: 8px; transition: all 0.15s; margin: 1px 0; }
    .nav-subitem:hover { background: rgba(99,102,241,0.08); color: var(--text-primary); }
    .nav-subitem.active { background: rgba(99,102,241,0.12); color: var(--accent-primary); font-weight: 600; }
</style>
<script>
    function toggleSubmenu(el) {
        const submenu = el.nextElementSibling;
        if (submenu && submenu.classList.contains('nav-submenu')) {
            submenu.classList.toggle('open');
            const arrow = el.querySelector('.nav-arrow');
            if (arrow) arrow.style.transform = submenu.classList.contains('open') ? 'rotate(180deg)' : '';
        }
    }
    // Handle user logout
    async function userLogout() {
        try {
            const response = await fetch('/api/logout', { 
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });
            if (response.ok) {
                window.location.href = '/';
            } else {
                // Force redirect even on error
                window.location.href = '/';
            }
        } catch (error) {
            console.error('[Logout Error]', error);
            window.location.href = '/';
        }
    }
    
    // Load site name from API on page load to refresh
    async function loadUserSiteName() {
        try {
            const res = await fetch('/api/settings');
            if (!res.ok) return;
            const settings = await res.json();
            const siteName = settings['site_name'] || '<%= siteName %>';
            const nameEl = document.getElementById('userSidebarName');
            if (nameEl) {
                nameEl.textContent = siteName;
            }
        } catch(e) {
            console.error('Failed to load site name:', e);
        }
    }
    
    // Sidebar toggle functions
    function toggleSidebar() {
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('open');
        overlay.classList.toggle('open');
        document.body.style.overflow = sidebar.classList.contains('open') ? 'hidden' : '';
    }
    
    function closeSidebar() {
        const sidebar = document.getElementById('adminSidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.remove('open');
        overlay.classList.remove('open');
        document.body.style.overflow = '';
    }
    
    // Load site name on page load
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadUserSiteName);
    } else {
        loadUserSiteName();
    }
    
    // Auto-refresh site name every 30 seconds
    setInterval(loadUserSiteName, 30000);
</script>