<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'My Virtual Machines - HKVM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    /* ============ SVG ICON SYSTEM ============ */
    .icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1em;
      height: 1em;
      vertical-align: -0.125em;
      flex-shrink: 0;
    }
    .icon svg { width: 100%; height: 100%; display: block; }

    /* ============ PAGE HEADER (Purple background REMOVED, server icon REMOVED) ============ */
    .page-header-enhanced {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 22px;
      padding: 0 0 10px 0;
      background: none;
      border: none;
      border-bottom: 1px solid var(--border-subtle);
      border-radius: 0;
      position: relative;
      overflow: visible;
    }
    .page-header-enhanced::before {
      content: none;
    }
    .page-title-enhanced {
      display: flex;
      align-items: center;
      gap: 0;
      font-size: 24px;
      font-weight: 700;
      margin: 0 0 6px 0;
      color: var(--text-primary);
    }
    .title-icon-wrap {
      display: none; /* Server icon hidden */
    }
    .page-subtitle-enhanced {
      color: var(--text-muted);
      margin: 0;
      font-size: 13px;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }
    .live-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.3);
      color: #10B981;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }
    .live-badge .pulse {
      width: 6px;
      height: 6px;
      background: #10B981;
      border-radius: 50%;
      animation: pulse-live 2s ease-in-out infinite;
    }
    @keyframes pulse-live {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    }

    /* ============ STATS ============ */
    .stats-enhanced {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 20px;
    }
    .stat-card-enhanced {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      padding: 16px;
      position: relative;
      overflow: hidden;
      transition: all 0.3s ease;
      cursor: pointer;
    }
    .stat-card-enhanced::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: var(--accent-color, #6366F1);
    }
    .stat-card-enhanced:hover {
      transform: translateY(-3px);
      border-color: var(--accent-color, #6366F1);
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.3);
    }
    .stat-card-enhanced.active {
      border-color: var(--accent-color, #6366F1);
      background: color-mix(in srgb, var(--accent-color, #6366F1) 6%, var(--bg-card));
    }
    .stat-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }
    .stat-icon-box {
      width: 42px;
      height: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      font-size: 20px;
      background: color-mix(in srgb, var(--accent-color, #6366F1) 15%, transparent);
      color: var(--accent-color, #6366F1);
      flex-shrink: 0;
    }
    .stat-value-enhanced {
      font-size: 24px;
      font-weight: 700;
      color: var(--text-primary);
      line-height: 1;
      margin-bottom: 4px;
    }
    .stat-label-enhanced {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* ============ FILTER BAR ============ */
    .filter-bar-enhanced {
      display: flex;
      gap: 10px;
      align-items: center;
      margin-bottom: 20px;
      padding: 12px;
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      flex-wrap: wrap;
    }
    .search-wrap {
      position: relative;
      flex: 1;
      min-width: 220px;
      max-width: 320px;
    }
    .search-wrap .search-icon-svg {
      position: absolute;
      top: 50%;
      left: 12px;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
      width: 15px;
      height: 15px;
    }
    .search-input {
      width: 100%;
      padding: 9px 12px 9px 36px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 13px;
      transition: all 0.2s;
    }
    .search-input:focus {
      outline: none;
      border-color: #6366F1;
      background: rgba(99, 102, 241, 0.05);
      box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .filter-select {
      padding: 9px 12px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      color: var(--text-primary);
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      min-width: 140px;
    }
    .filter-select:hover, .filter-select:focus {
      border-color: #6366F1;
      outline: none;
    }
    .view-switcher {
      display: flex;
      gap: 4px;
      padding: 3px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      margin-left: auto;
    }
    .view-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 30px;
      background: transparent;
      border: none;
      border-radius: 6px;
      color: var(--text-muted);
      cursor: pointer;
      transition: all 0.2s;
      font-size: 14px;
    }
    .view-btn:hover { color: var(--text-primary); background: rgba(255, 255, 255, 0.04); }
    .view-btn.active {
      background: linear-gradient(135deg, #6366F1, #8B5CF6);
      color: white;
      box-shadow: 0 4px 10px rgba(99, 102, 241, 0.3);
    }

    /* ============ REFRESH BUTTON ============ */
    .btn-refresh {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: rgba(99, 102, 241, 0.1);
      border: 1px solid rgba(99, 102, 241, 0.3);
      border-radius: 10px;
      color: #6366F1;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
    }
    .btn-refresh:hover {
      background: rgba(99, 102, 241, 0.18);
      transform: translateY(-1px);
    }
    .btn-refresh.spinning svg { animation: spin 0.8s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ============ VM GRID CARDS ============ */
    .vm-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 18px;
    }
    .vm-card-enhanced {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 14px;
      padding: 18px;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
      cursor: pointer;
    }
    .vm-card-enhanced::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
    }
    .vm-card-enhanced.running::before { background: linear-gradient(90deg, #10B981, #06B6D4); }
    .vm-card-enhanced.stopped::before { background: linear-gradient(90deg, #6B7280, #4B5563); }
    .vm-card-enhanced.error::before { background: linear-gradient(90deg, #EF4444, #DC2626); }
    .vm-card-enhanced.paused::before { background: linear-gradient(90deg, #F59E0B, #F97316); }
    .vm-card-enhanced:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      border-color: rgba(99, 102, 241, 0.4);
    }

    .vm-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 14px;
    }
    .vm-title-block {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
      flex: 1;
    }
    .vm-os-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.08));
      border: 1px solid rgba(99, 102, 241, 0.2);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      overflow: hidden;
      padding: 6px;
    }
    .vm-os-icon img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .vm-name-enhanced {
      font-size: 15px;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0 0 3px 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .vm-meta-enhanced {
      font-size: 11px;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .vm-id-chip {
      background: rgba(99, 102, 241, 0.1);
      color: #6366F1;
      padding: 1px 7px;
      border-radius: 6px;
      font-family: 'SF Mono', monospace;
      font-weight: 600;
      font-size: 10px;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      white-space: nowrap;
    }
    .status-badge.running {
      background: rgba(16, 185, 129, 0.12);
      color: #10B981;
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-badge.stopped {
      background: rgba(107, 114, 128, 0.12);
      color: #9CA3AF;
      border: 1px solid rgba(107, 114, 128, 0.3);
    }
    .status-badge.error {
      background: rgba(239, 68, 68, 0.12);
      color: #EF4444;
      border: 1px solid rgba(239, 68, 68, 0.3);
    }
    .status-badge.paused {
      background: rgba(245, 158, 11, 0.12);
      color: #F59E0B;
      border: 1px solid rgba(245, 158, 11, 0.3);
    }
    .status-badge .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }
    .status-badge.running .status-dot {
      animation: pulse-live 2s ease-in-out infinite;
    }

    .vm-specs {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      padding: 12px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid var(--border-subtle);
      border-radius: 10px;
      margin-bottom: 12px;
    }
    .spec-item {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
    }
    .spec-icon-mini {
      width: 26px;
      height: 26px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 6px;
      font-size: 13px;
      flex-shrink: 0;
    }
    .spec-icon-mini.mem { background: rgba(16, 185, 129, 0.12); color: #10B981; }
    .spec-icon-mini.cpu { background: rgba(236, 72, 153, 0.12); color: #EC4899; }
    .spec-icon-mini.disk { background: rgba(6, 182, 212, 0.12); color: #06B6D4; }
    .spec-icon-mini.net { background: rgba(59, 130, 246, 0.12); color: #3B82F6; }
    .spec-content {
      display: flex;
      flex-direction: column;
      min-width: 0;
      flex: 1;
    }
    .spec-label {
      font-size: 9px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1;
      margin-bottom: 2px;
    }
    .spec-value {
      font-size: 12px;
      color: var(--text-primary);
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .vm-actions-enhanced {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: 6px;
    }
    .btn-action {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      padding: 8px 6px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 600;
      border: 1px solid var(--border-color);
      background: transparent;
      color: var(--text-secondary);
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s ease;
    }
    .btn-action:hover {
      transform: translateY(-1px);
      border-color: var(--accent-primary);
      color: var(--accent-primary);
    }
    .btn-action.start {
      background: linear-gradient(135deg, #10B981, #059669);
      border-color: transparent;
      color: white;
    }
    .btn-action.start:hover {
      box-shadow: 0 6px 16px rgba(16, 185, 129, 0.4);
      color: white;
    }
    .btn-action.stop {
      background: linear-gradient(135deg, #EF4444, #DC2626);
      border-color: transparent;
      color: white;
    }
    .btn-action.stop:hover {
      box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4);
      color: white;
    }
    .btn-action.primary {
      background: linear-gradient(135deg, #6366F1, #8B5CF6);
      border-color: transparent;
      color: white;
    }
    .btn-action.primary:hover {
      box-shadow: 0 6px 16px rgba(99, 102, 241, 0.4);
      color: white;
    }

    /* ============ LIST VIEW TABLE ============ */
    .vm-table-wrap {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
      overflow: hidden;
    }
    .vm-table {
      width: 100%;
      border-collapse: collapse;
    }
    .vm-table thead {
      background: rgba(99, 102, 241, 0.04);
      border-bottom: 1px solid var(--border-subtle);
    }
    .vm-table th {
      padding: 14px 16px;
      text-align: left;
      font-size: 11px;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .vm-table td {
      padding: 14px 16px;
      font-size: 13px;
      color: var(--text-secondary);
      border-bottom: 1px solid var(--border-subtle);
      vertical-align: middle;
    }
    .vm-table tbody tr {
      transition: background 0.15s;
    }
    .vm-table tbody tr:hover {
      background: rgba(99, 102, 241, 0.04);
    }
    .vm-table tbody tr:last-child td { border-bottom: none; }
    .vm-name-link {
      color: var(--text-primary);
      font-weight: 600;
      text-decoration: none;
    }
    .vm-name-link:hover { color: #6366F1; }
    .btn-icon-only {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 7px;
      border: 1px solid var(--border-color);
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: all 0.2s;
      font-size: 13px;
    }
    .btn-icon-only:hover {
      transform: translateY(-1px);
      border-color: var(--accent-primary);
    }
    .btn-icon-only.start { background: rgba(16, 185, 129, 0.1); color: #10B981; border-color: rgba(16, 185, 129, 0.3); }
    .btn-icon-only.stop { background: rgba(239, 68, 68, 0.1); color: #EF4444; border-color: rgba(239, 68, 68, 0.3); }
    .btn-icon-only.restart { background: rgba(139, 92, 246, 0.1); color: #8B5CF6; border-color: rgba(139, 92, 246, 0.3); }

    /* ============ EMPTY / ERROR STATES ============ */
    .empty-enhanced {
      background: var(--bg-card);
      border: 1px dashed var(--border-color);
      border-radius: 16px;
      padding: 60px 24px;
      text-align: center;
    }
    .empty-icon-wrap {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(139, 92, 246, 0.05));
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #6366F1;
      font-size: 36px;
    }
    .empty-title { font-size: 18px; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
    .empty-desc { color: var(--text-muted); font-size: 13px; max-width: 400px; margin: 0 auto 20px; }

    /* ============ LOADING SKELETON ============ */
    .skeleton-card {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 14px;
      height: 280px;
      position: relative;
      overflow: hidden;
    }
    .skeleton-card::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04), transparent);
      animation: shimmer 1.5s infinite;
    }
    @keyframes shimmer { to { transform: translateX(100%); } }

    /* ============ TOASTS ============ */
    .toast-container {
      position: fixed;
      top: 20px;
      right: 20px;
      z-index: 3000;
      display: flex;
      flex-direction: column;
      gap: 10px;
      max-width: 380px;
    }
    .toast {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-left: 3px solid #6366F1;
      border-radius: 10px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
      animation: slideInToast 0.3s ease-out;
      min-width: 300px;
    }
    .toast.removing { animation: slideOutToast 0.3s ease-out forwards; }
    .toast-success { border-left-color: #10B981; }
    .toast-error { border-left-color: #EF4444; }
    .toast-warning { border-left-color: #F59E0B; }
    .toast-info { border-left-color: #6366F1; }
    .toast-icon {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .toast-success .toast-icon { color: #10B981; }
    .toast-error .toast-icon { color: #EF4444; }
    .toast-warning .toast-icon { color: #F59E0B; }
    .toast-info .toast-icon { color: #6366F1; }
    .toast-message { flex: 1; color: var(--text-primary); font-size: 13px; font-weight: 500; }
    .toast-close {
      background: transparent; border: none; color: var(--text-muted);
      cursor: pointer; font-size: 18px; padding: 0; width: 20px; height: 20px;
      display: flex; align-items: center; justify-content: center;
    }
    .toast-close:hover { color: var(--text-primary); }
    @keyframes slideInToast {
      from { transform: translateX(120%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes slideOutToast {
      to { transform: translateX(120%); opacity: 0; }
    }
    @keyframes slideInModal {
      from { transform: scale(0.9) translateY(-20px); opacity: 0; }
      to { transform: scale(1) translateY(0); opacity: 1; }
    }

    /* ============ RESPONSIVE ============ */
    @media (max-width: 900px) {
      .stats-enhanced { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      .vm-actions-enhanced { grid-template-columns: 1fr 1fr; }
      .vm-specs { grid-template-columns: 1fr; }
      .page-header-enhanced { padding: 0 0 10px 0; }
      .page-title-enhanced { font-size: 20px; }
      .view-switcher { margin-left: 0; width: 100%; justify-content: center; }
      .filter-select { width: 100%; }
      .search-wrap { max-width: none; }
    }
  </style>
</head>
<body>

<!-- SVG ICON DEFINITIONS -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-server" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="20" height="7" rx="2"/><rect x="2" y="14" width="20" height="7" rx="2"/>
      <line x1="6" y1="6.5" x2="6.01" y2="6.5"/><line x1="6" y1="17.5" x2="6.01" y2="17.5"/>
    </symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
      <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
    </symbol>
    <symbol id="i-play" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"/></symbol>
    <symbol id="i-stop" viewBox="0 0 24 24" fill="currentColor"><rect x="5" y="5" width="14" height="14" rx="2"/></symbol>
    <symbol id="i-restart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12a9 9 0 11-3-6.7L21 8"/><path d="M21 3v5h-5"/>
    </symbol>
    <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
    </symbol>
