<script>
let allVMs = [];
let currentView = 'list';

function formatMem(mem) {
  if (!mem) return '—';
  return mem >= 1024 ? (mem / 1024).toFixed(1) + ' GB' : mem + ' MB';
}

function formatTime() {
  return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

function getStatusClass(status) {
  return status || 'stopped';
}

function setView(view) {
  currentView = view;
  document.getElementById('viewGrid').classList.toggle('active', view === 'grid');
  document.getElementById('viewList').classList.toggle('active', view === 'list');
  renderVMs();
}

function quickFilter(status) {
  document.getElementById('statusFilter').value = status;
  document.querySelectorAll('.stat-card-enhanced[data-filter]').forEach(c => {
    c.classList.toggle('active', c.dataset.filter === status);
  });
  renderVMs();
}

async function loadVMs() {
  const btn = document.getElementById('refreshBtn');
  btn.classList.add('spinning');
  
  try {
    const res = await fetch('/api/vms');
    if (!res.ok) throw new Error('Failed to fetch VMs');
    allVMs = await res.json();
    
    const total = allVMs.length;
    const running = allVMs.filter(v => v.status === 'running').length;
    const stopped = allVMs.filter(v => v.status === 'stopped').length;
    const totalMem = allVMs.reduce((s, v) => s + (v.memory || 0), 0);

    animateNumber('totalCount', total);
    animateNumber('runningCount', running);
    animateNumber('stoppedCount', stopped);
    document.getElementById('totalMemory').textContent = formatMem(totalMem);
    document.getElementById('lastUpdate').textContent = `· Updated ${formatTime()}`;

    renderVMs();
  } catch(e) {
    document.getElementById('vmContainer').innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap" style="color: var(--color-red); background: linear-gradient(135deg, var(--color-red-light), rgba(239,68,68,0.05));">
          <svg class="icon"><use href="#i-alert"/></svg>
        </div>
        <div class="empty-title">Failed to Load VMs</div>
        <div class="empty-desc">${escHtml(e.message)}</div>
        <button class="btn-refresh" onclick="loadVMs()">
          <svg class="icon"><use href="#i-refresh"/></svg> Try Again
        </button>
      </div>`;
    showToast('Failed to load VMs: ' + e.message, 'error');
  } finally {
    setTimeout(() => btn.classList.remove('spinning'), 500);
  }
}

function getFilteredVMs() {
  const q = document.getElementById('vmSearch')?.value.toLowerCase() || '';
  const status = document.getElementById('statusFilter')?.value || '';
  
  return allVMs.filter(vm => {
    const matchQ = !q || 
      vm.vm_name?.toLowerCase().includes(q) || 
      String(vm.vm_id).includes(q) ||
      vm.os_type?.toLowerCase().includes(q) ||
      vm.template_name?.toLowerCase().includes(q) ||
      vm.ipv4_address?.includes(q);
    const matchStatus = !status || vm.status === status;
    return matchQ && matchStatus;
  });
}

function renderVMs() {
  const filtered = getFilteredVMs();
  const container = document.getElementById('vmContainer');
  
  if (allVMs.length === 0) {
    container.innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap"><svg class="icon"><use href="#i-server"/></svg></div>
        <div class="empty-title">No Virtual Machines</div>
        <div class="empty-desc">You don't have any VMs assigned yet. Contact your administrator to request virtual machines.</div>
      </div>`;
    return;
  }

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap"><svg class="icon"><use href="#i-search"/></svg></div>
        <div class="empty-title">No VMs Found</div>
        <div class="empty-desc">No VMs match your search criteria. Try a different filter.</div>
      </div>`;
    return;
  }

  if (currentView === 'grid') {
    renderGridView(filtered, container);
  } else {
    renderListView(filtered, container);
  }
}

function renderGridView(vms, container) {
  container.innerHTML = `
    <div class="vm-grid">
      ${vms.map(vm => renderVMCard(vm)).join('')}
    </div>`;
}

function renderVMCard(vm) {
  const icon = vm.template_icon;
  const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
  const status = vm.status || 'stopped';
  
  return `
    <div class="vm-card-enhanced ${status}" onclick="window.location.href='/vm/${vm.vm_id}'">
      <div class="vm-card-header">
        <div class="vm-title-block">
          <div class="vm-os-icon">
            <img src="${displayIcon}" alt="OS" onerror="this.src='https://i.imgur.com/wu0Ob6B.png'">
          </div>
          <div style="min-width: 0; flex: 1;">
            <div class="vm-name-enhanced">${escHtml(vm.vm_name)}</div>
            <div class="vm-meta-enhanced">
              <span>${escHtml(vm.template_name || vm.os_type || 'Custom')}</span>
              <span class="vm-id-chip">#${vm.vm_id}</span>
            </div>
          </div>
        </div>
        <span class="status-badge ${status}">
          <span class="status-dot"></span>${status}
        </span>
      </div>

      <div class="vm-specs">
        <div class="spec-item">
          <div class="spec-icon-mini mem"><svg class="icon"><use href="#i-mem"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Memory</div>
            <div class="spec-value">${vm.memory ? vm.memory + ' MB' : '—'}</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon-mini cpu"><svg class="icon"><use href="#i-cpu"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">vCPUs</div>
            <div class="spec-value">${vm.cpus || '—'} Cores</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon-mini disk"><svg class="icon"><use href="#i-disk"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Storage</div>
            <div class="spec-value">${vm.disk_size || '—'}</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon-mini net"><svg class="icon"><use href="#i-network"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Network</div>
            <div class="spec-value">${vm.ipv4_address || vm.network_type || 'DHCP'}</div>
          </div>
        </div>
      </div>

      <div class="vm-actions-enhanced" onclick="event.stopPropagation()">
        ${status === 'stopped' 
          ? `<button class="btn-action start" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
              <svg class="icon"><use href="#i-play"/></svg> Start
            </button>`
          : `<button class="btn-action stop" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
              <svg class="icon"><use href="#i-stop"/></svg> Stop
            </button>`
        }
        <a href="/vm/${vm.vm_id}" class="btn-action primary">
          <svg class="icon"><use href="#i-info"/></svg> Info
        </a>
        <a href="/vm/${vm.vm_id}/console" class="btn-action">
          <svg class="icon"><use href="#i-terminal"/></svg> Term
        </a>
        <a href="/vm/${vm.vm_id}/ssh" class="btn-action">
          <svg class="icon"><use href="#i-key"/></svg> SSH
        </a>
        <a href="/vm/${vm.vm_id}/tmate" class="btn-action" style="color: #8B5CF6;">
          <svg class="icon"><use href="#i-link"/></svg> tmate
        </a>
        <a href="/vm/${vm.vm_id}/novnc" class="btn-action" style="color: #06B6D4;">
          <svg class="icon"><use href="#i-camera"/></svg> Web
        </a>
        <button class="btn-action" style="color: #EF4444;" onclick="vmAction('delete', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
          <svg class="icon"><use href="#i-trash"/></svg> Delete
        </button>
      </div>
    </div>
  `;
}

function renderListView(vms, container) {
  container.innerHTML = `
    <div class="vm-table-wrap">
      <div style="overflow-x: auto;">
        <table class="vm-table">
          <thead>
            <tr>
              <th>VM</th>
              <th>Status</th>
              <th>Resources</th>
              <th>Storage</th>
              <th>Network</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            ${vms.map(vm => {
              const icon = vm.template_icon;
              const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
              const status = vm.status || 'stopped';
              
              return `
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <div class="vm-os-icon" style="width: 36px; height: 36px; padding: 5px;">
                      <img src="${displayIcon}" alt="OS" onerror="this.src='https://i.imgur.com/wu0Ob6B.png'">
                    </div>
                    <div>
                      <a href="/vm/${vm.vm_id}" class="vm-name-link">${escHtml(vm.vm_name)}</a>
                      <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">
                        <span class="vm-id-chip">#${vm.vm_id}</span>
                        <span style="margin-left: 6px;">${escHtml(vm.template_name || vm.os_type || 'Custom')}</span>
                      </div>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="status-badge ${status}">
                    <span class="status-dot"></span>${status}
                  </span>
                </td>
                <td>
                  <div style="display: flex; gap: 12px; font-size: 12px;">
                    <div style="display: flex; align-items: center; gap: 5px;" title="vCPUs">
                      <span style="color: #EC4899;"><svg class="icon" style="width:12px;height:12px"><use href="#i-cpu"/></svg></span>
                      <strong style="color: var(--text-primary);">${vm.cpus || '—'}</strong>
                    </div>
                    <div style="display: flex; align-items: center; gap: 5px;" title="Memory">
                      <span style="color: #10B981;"><svg class="icon" style="width:12px;height:12px"><use href="#i-mem"/></svg></span>
                      <strong style="color: var(--text-primary);">${formatMem(vm.memory)}</strong>
                    </div>
                  </div>
                </td>
                <td>
                  <div style="display: flex; align-items: center; gap: 6px; font-size: 12px;">
                    <span style="color: #06B6D4;"><svg class="icon" style="width:12px;height:12px"><use href="#i-disk"/></svg></span>
                    <strong style="color: var(--text-primary);">${vm.disk_size || '—'}</strong>
