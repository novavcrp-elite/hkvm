<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title>404 - Page Not Found · HKVM Panel</title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="login-bg"></div>
<div class="login-bg-grid"></div>

<div class="error-page" style="position: relative; z-index: 1;">
  <div style="text-align: center; animation: fadeIn 0.6s ease;">
    <div class="error-code">404</div>
    <div class="error-title">Page Not Found</div>
    <div class="error-desc">
      <%= message || 'The page you are looking for does not exist or has been moved.' %>
    </div>
    
    <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap;">
      <a href="/dashboard" class="btn btn-primary btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        Go Home
      </a>
      <button onclick="history.back()" class="btn btn-ghost btn-lg">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        Go Back
      </button>
    </div>

    <div style="margin-top: 40px; display: flex; justify-content: center; gap: 20px; flex-wrap: wrap;">
      <a href="/admin/vms" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">🖥️ VMs</a>
      <a href="/admin/users" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">👥 Users</a>
      <a href="/admin/settings" style="color: var(--text-muted); text-decoration: none; font-size: 13px;">⚙️ Settings</a>
    </div>
  </div>
</div>
</body>
</html>



