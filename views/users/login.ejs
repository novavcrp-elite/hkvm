<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Login - HKVM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    html, body {
      height: auto;
      min-height: 100vh;
    }

    .login-form-icon-toggle {
      position: absolute;
      right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none;
      color: var(--text-muted); cursor: pointer;
      padding: 4px; font-size: 16px;
      transition: color 0.15s;
    }
    .login-form-icon-toggle:hover { color: var(--text-primary); }
    .pw-wrapper { position: relative; }
    .pw-wrapper .form-control { padding-right: 40px; }
    
    @keyframes loginFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.4; }
      50% { transform: translateY(-15px) rotate(3deg); opacity: 0.8; }
    }
    
    .login-float-icon {
      position: absolute;
      font-size: 24px;
      animation: loginFloat ease-in-out infinite;
      pointer-events: none;
    }
    
    .shake {
      animation: shake 0.4s ease;
    }
    
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      75% { transform: translateX(8px); }
    }

    /* Logo inside card */
    .login-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .login-logo-inside {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .login-logo-icon {
      width: 64px;
      height: 64px;
      background: transparent;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      animation: float 3.5s ease-in-out infinite;
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }

      .login-container {
        max-width: 100%;
        width: 100%;
        padding: 20px;
      }

      .login-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }

      .login-logo-inside {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }

      .login-logo-icon {
        width: 56px;
        height: 56px;
        font-size: 36px;
        margin: 0;
      }

      .login-logo-title {
        font-size: 20px;
      }

      .login-logo-sub {
        font-size: 12px;
      }

      .login-card {
        padding: 24px 20px;
        border-radius: 16px;
      }

      .login-title {
        font-size: 16px;
        margin-bottom: 6px;
      }

      .login-subtitle {
        font-size: 12px;
        margin-bottom: 20px;
      }

      .form-label {
        font-size: 11px;
      }

      .form-control {
        font-size: 14px;
        padding: 10px 12px;
      }

      .btn-lg {
        padding: 11px 20px;
        font-size: 13px;
      }

      .login-footer {
        font-size: 11px;
        margin-top: 20px;
      }
    }

    @media (max-width: 480px) {
      .login-page {
        padding: 12px;
      }

      .login-container {
        padding: 16px;
      }

      .login-card-header {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .login-logo-icon {
        width: 48px;
        height: 48px;
        font-size: 32px;
        margin: 0;
      }

      .login-logo-title {
        font-size: 18px;
      }

      .login-card {
        padding: 20px 16px;
        border-radius: 14px;
      }

      .login-title {
        font-size: 15px;
      }

      .login-subtitle {
        font-size: 11px;
      }

      .form-group {
        margin-bottom: 14px;
      }

      .form-label {
        font-size: 10px;
        margin-bottom: 6px;
      }

      .form-control {
        font-size: 16px; /* Prevents zoom on iOS */
        padding: 10px 12px;
      }

      .login-form-icon-toggle {
        right: 10px;
        font-size: 14px;
      }

      .btn-lg {
        padding: 10px 18px;
        font-size: 13px;
        gap: 5px;
      }

      .login-footer {
        font-size: 10px;
        margin-top: 16px;
      }

      /* Hide floating icons on small screens */
      .login-float-icon {
        display: none;
      }
    }
  </style>
</head>
<body>

<!-- Animated Background -->
<div class="login-bg"></div>
<div class="login-bg-grid"></div>

<!-- Floating Decorative Icons -->
<span class="login-float-icon" style="top:10%; left:8%; animation-duration:4s; animation-delay:0s;">💻</span>
<span class="login-float-icon" style="top:20%; right:10%; animation-duration:5s; animation-delay:1s;">🖥️</span>
<span class="login-float-icon" style="bottom:15%; left:12%; animation-duration:6s; animation-delay:2s;">⚡</span>
<span class="login-float-icon" style="bottom:25%; right:8%; animation-duration:4.5s; animation-delay:0.5s;">🔐</span>
<span class="login-float-icon" style="top:50%; left:3%; animation-duration:7s; animation-delay:1.5s;">🌐</span>

<div class="login-page">
  <div class="login-container">

    <!-- Login Card -->
    <div class="login-card" id="loginCard">
      <!-- Logo Inside Card (Right Side) -->
      <div class="login-card-header">
        <div>
          <div class="login-title">Welcome Back</div>
          <div class="login-subtitle">Sign in to access your control panel</div>
        </div>
        <div class="login-logo-inside">
          <div class="login-logo-icon" style="display: flex; align-items: center; justify-content: center;">
            <img src="<%= siteLogo %>" style="width: 48px; height: 48px; object-fit: contain; border-radius: 8px;" alt="HKVM Logo">
          </div>
        </div>
      </div>

      <!-- Alert -->
      <div id="loginAlert" style="display:none; margin-bottom: 16px;"></div>

      <form id="loginForm" onsubmit="handleLogin(event)">

        <!-- Username -->
        <div class="form-group">
          <label class="form-label" for="username">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
            Username
          </label>
          <input
            type="text"
            id="username"
            name="username"
            class="form-control"
            placeholder="Enter your username"
            autocomplete="username"
            autofocus
            required
          >
        </div>

        <!-- Password -->
        <div class="form-group">
          <label class="form-label" for="password">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:inline;">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0110 0v4"></path>
            </svg>
            Password
          </label>
          <div class="pw-wrapper">
            <input
              type="password"
              id="password"
              name="password"
              class="form-control"
              placeholder="Enter your password"
              autocomplete="current-password"
              required
            >
            <button type="button" class="login-form-icon-toggle" onclick="togglePassword()" id="pwToggle" aria-label="Toggle password">
              👁️
            </button>
          </div>
        </div>

        <!-- Remember + Options -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 8px;">
          <label class="toggle-switch" style="cursor:pointer;">
            <input type="checkbox" class="toggle-input" id="rememberMe">
            <div class="toggle-track">
              <div class="toggle-thumb"></div>
            </div>
            <span class="toggle-label" style="font-size: 12px;">Remember me</span>
          </label>
        </div>

        <!-- Submit -->
        <button type="submit" class="btn btn-primary w-100 btn-lg" id="loginBtn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"></path>
            <polyline points="10 17 15 12 10 7"></polyline>
            <line x1="15" y1="12" x2="3" y2="12"></line>
          </svg>
          Sign In
        </button>

      </form>

    <div class="login-footer">
      <%= siteName %> <%= panelVersion %> · &copy; <%= new Date().getFullYear() %> HopingBoyz
      <br>
      <span style="font-size: 10px; color: var(--text-muted);">Powered by QEMU/KVM + Express.js</span>
    </div>

  </div>
</div>

<script>
// Toggle password visibility
function togglePassword() {
  const pw = document.getElementById('password');
  const btn = document.getElementById('pwToggle');
  if (pw.type === 'password') {
    pw.type = 'text';
    btn.textContent = '🙈';
  } else {
    pw.type = 'password';
    btn.textContent = '👁️';
  }
}

// Handle login
async function handleLogin(e) {
  e.preventDefault();
  
  const username = document.getElementById('username').value.trim();
  const password = document.getElementById('password').value;
  const btn = document.getElementById('loginBtn');
  const alert = document.getElementById('loginAlert');
  const card = document.getElementById('loginCard');
  
  if (!username || !password) {
    showAlert('Please fill in all fields', 'error');
    return;
  }
  
  btn.classList.add('loading');
  btn.textContent = '';
  btn.disabled = true;
  alert.style.display = 'none';
  
  try {
    const res = await fetch('/api/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, password })
    });
    
    const data = await res.json();
    
    if (res.ok && data.success) {
      btn.innerHTML = '✅ Success! Redirecting...';
      btn.style.background = 'var(--gradient-green)';
      
      setTimeout(() => {
        window.location.href = '/dashboard';
      }, 600);
    } else {
      card.classList.add('shake');
      setTimeout(() => card.classList.remove('shake'), 400);
      showAlert(data.error || 'Invalid username or password', 'error');
      btn.classList.remove('loading');
      btn.disabled = false;
      btn.innerHTML = `
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"></path>
          <polyline points="10 17 15 12 10 7"></polyline>
          <line x1="15" y1="12" x2="3" y2="12"></line>
        </svg>
        Sign In
      `;
    }
  } catch (err) {
    card.classList.add('shake');
    setTimeout(() => card.classList.remove('shake'), 400);
    showAlert('Connection error. Please try again.', 'error');
    btn.classList.remove('loading');
    btn.disabled = false;
    btn.innerHTML = `
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"></path>
        <polyline points="10 17 15 12 10 7"></polyline>
        <line x1="15" y1="12" x2="3" y2="12"></line>
      </svg>
      Sign In
    `;
  }
}

function showAlert(message, type) {
  const alert = document.getElementById('loginAlert');
  const icons = { error: '❌', success: '✅', warning: '⚠️', info: 'ℹ️' };
  alert.className = `alert alert-${type}`;
  alert.innerHTML = `<span class="alert-icon">${icons[type]}</span><span>${message}</span>`;
  alert.style.display = 'flex';
}

// Enter key on password
document.getElementById('password').addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    document.getElementById('loginForm').dispatchEvent(new Event('submit'));
  }
});

// Load login page branding
async function loadLoginBranding() {
  try {
    const res = await fetch('/api/settings');
    if (!res.ok) return;
    const settings = await res.json();
    
    const siteIconUrl = settings['site_icon_url'] || '/images/logo.png';
    const siteName = settings['site_name'] || 'HKVM Panel';
    const siteDesc = settings['site_description'] || 'Professional VM Management Platform';
    
    const iconImg = document.getElementById('loginIconImg');
    const iconFallback = document.getElementById('loginIconFallback');
    const nameEl = document.querySelector('.login-logo-title');
    const descEl = document.querySelector('.login-logo-sub');
    
    if (iconImg && siteIconUrl) {
      iconImg.src = siteIconUrl;
      iconImg.style.display = 'block';
      if (iconFallback) iconFallback.style.display = 'none';
    } else {
      if (iconImg) iconImg.style.display = 'none';
      if (iconFallback) iconFallback.style.display = 'flex';
    }
    
    if (nameEl) nameEl.textContent = siteName;
    if (descEl) descEl.textContent = siteDesc;
  } catch(e) {
    console.error('Failed to load branding:', e);
    // Fallback: show default logo
    const iconImg = document.getElementById('loginIconImg');
    const iconFallback = document.getElementById('loginIconFallback');
    if (iconImg) {
      iconImg.src = '/images/logo.png';
      iconImg.style.display = 'block';
    }
    if (iconFallback) iconFallback.style.display = 'none';
  }
}

// Load branding on page load
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', loadLoginBranding);
} else {
  loadLoginBranding();
}
</script>
</body>
</html>




