<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content" id="pageContent">
      <div style="text-align: center; padding: 80px;">
        <div class="spinner spinner-lg" style="margin: 0 auto 16px;"></div>
        <div style="color: var(--text-muted);">Loading VM details...</div>
      </div>
    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<!-- Snapshot Modal -->
<div class="modal-overlay" id="snapshotModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#8B5CF6;display:inline-flex;"><svg width="18" height="18"><use href="#i-camera"/></svg></span>
        Create Snapshot
      </div>
      <button class="modal-close" onclick="closeModal('snapshotModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group">
        <label class="form-label">Snapshot Name <span class="required">*</span></label>
        <input type="text" class="form-control" id="snapshotName" placeholder="e.g., before-update-2025">
      </div>
      <div class="form-group">
        <label class="form-label">Description</label>
        <textarea class="form-control" id="snapshotDesc" placeholder="Optional description..." rows="2"></textarea>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('snapshotModal')">Cancel</button>
      <button class="btn btn-primary" onclick="createSnapshot()">
        <svg width="14" height="14" style="margin-right:6px;"><use href="#i-camera"/></svg>
        Create Snapshot
      </button>
    </div>
  </div>
</div>

<!-- Reinstall Modal -->
<div class="modal-overlay" id="reinstallModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#F59E0B;display:inline-flex;"><svg width="18" height="18"><use href="#i-refresh"/></svg></span>
        Reinstall VM
      </div>
      <button class="modal-close" onclick="closeModal('reinstallModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="alert alert-warning" style="margin-bottom: 16px;">
        <span class="alert-icon" style="color:#F59E0B;display:inline-flex;"><svg width="16" height="16"><use href="#i-alert"/></svg></span>
        <span><strong>Warning!</strong> This will delete the VM disk and cloud-init seed. Logs will be kept for audit trail.</span>
      </div>
      
      <form id="reinstallForm" onsubmit="performReinstall(event)">
        <div class="form-group">
          <label class="form-label" style="font-weight: 600;">Select OS Template <span class="required">*</span></label>
          <select class="form-control" name="new_os_template" id="reinstall_template" required style="margin-bottom: 12px;">
            <option value="">— Choose Template —</option>
          </select>
          <div class="form-hint" style="color: var(--text-muted);">Select a new OS to reinstall. Keep current or choose different.</div>
        </div>
        
        <div class="form-group">
          <label class="form-label" style="font-weight: 600;">New Username (Optional)</label>
          <input type="text" class="form-control" name="new_username" id="reinstall_username" placeholder="Leave blank to keep current">
          <div class="form-hint">Default user for cloud-init templates (ubuntu, debian, root, etc.)</div>
        </div>
        
        <div class="form-group">
          <label class="form-label" style="font-weight: 600;">New Password (Optional)</label>
          <input type="password" class="form-control" name="new_password" id="reinstall_password" placeholder="Leave blank to keep current">
          <div class="form-hint">SSH password for the new installation</div>
        </div>
        
        <label class="toggle-switch" style="margin: 16px 0;">
          <input type="checkbox" class="toggle-input" name="confirm" id="reinstall_confirm" required>
          <div class="toggle-track"><div class="toggle-thumb"></div></div>
          <div>
            <div class="toggle-label" style="font-size: 13px; color: var(--text-primary);">I understand this will delete all VM data</div>
          </div>
        </label>
      </form>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('reinstallModal')">Cancel</button>
      <button class="btn btn-danger" id="confirmReinstallBtn" onclick="document.getElementById('reinstallForm').dispatchEvent(new Event('submit'))">
        <svg width="14" height="14" style="margin-right:6px;"><use href="#i-refresh"/></svg>
        Reinstall
      </button>
    </div>
  </div>
</div>

<!-- ISO Attach Modal -->
<div class="modal-overlay" id="isoAttachModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display:flex;align-items:center;gap:8px;">
        <span style="color:#06B6D4;display:inline-flex;"><svg width="18" height="18"><use href="#i-disc"/></svg></span>
        Attach ISO to VM
      </div>
      <button class="modal-close" onclick="closeModal('isoAttachModal')">✕</button>
    </div>
    <div class="modal-body">
      <div class="alert alert-info" style="margin-bottom: 16px;">
        <span class="alert-icon" style="color:#3B82F6;display:inline-flex;"><svg width="16" height="16"><use href="#i-info"/></svg></span>
        <span><strong>ISO Boot:</strong> VM will boot from this ISO. After OS installation completes, detach the ISO to boot from disk.</span>
      </div>
      
      <div class="form-group">
        <label class="form-label" style="font-weight: 600;">Select ISO File <span class="required">*</span></label>
        <select class="form-control" id="isoFileSelect" required>
          <option value="">— Loading ISO files... —</option>
        </select>
        <div class="form-hint" style="color: var(--text-muted); margin-top: 8px;">
          Choose an ISO file to attach. Upload new ISOs to <code>/home/user/vms/iso/</code>
        </div>
      </div>
      
      <div class="alert alert-warning" style="margin-top: 16px;">
        <span class="alert-icon" style="color:#F59E0B;display:inline-flex;"><svg width="16" height="16"><use href="#i-alert"/></svg></span>
        <span><strong>Note:</strong> You may need to restart the VM to boot from the attached ISO.</span>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('isoAttachModal')">Cancel</button>
      <button class="btn btn-primary" onclick="performISOAttach()">
        <svg width="14" height="14" style="margin-right:6px;"><use href="#i-attach"/></svg>
        Attach ISO
      </button>
    </div>
  </div>
</div>

<script>
const vmId = <%= vmId %>;
let vmData = null;
let statsInterval = null;

// SVG helper for dynamic contexts
function svg(id, size = 14) {
  return `<svg width="${size}" height="${size}"><use href="#${id}"/></svg>`;
}

async function loadVM() {
  try {
    const [vmRes, statsRes] = await Promise.all([
      fetch(`/api/vms/${vmId}`),
      fetch(`/api/vms/${vmId}/stats`).catch(() => null)
    ]);

    if (!vmRes.ok) throw new Error('VM not found');
    vmData = await vmRes.json();
    const stats = statsRes && statsRes.ok ? await statsRes.json() : null;
    
    renderPage(vmData, stats);
    setTimeout(() => loadISOStatus(), 400);
  } catch(e) {
    document.getElementById('pageContent').innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon" style="color:#EF4444;">${svg('i-alert', 48)}</div>
        <div class="empty-state-title">VM Not Found</div>
        <div class="empty-state-desc">${escHtml(e.message)}</div>
        <a href="/vms" class="btn btn-primary">${svg('i-back', 13)} Back to VMs</a>
      </div>`;
  }
}

function renderPage(vm, stats) {
  const statusCls = vm.status === 'running' ? 'badge-running' : vm.status === 'error' ? 'badge-error' : 'badge-stopped';
  const isRunning = vm.status === 'running';
  const icon = vm.template_icon;
  const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
  
  document.getElementById('pageContent').innerHTML = `
    <!-- Page Header -->
    <div class="page-header" style="align-items:center;">
      <div style="display: flex; align-items: center; gap: 14px; flex: 1; min-width: 0;">
        <a href="/vms" style="color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 13px; flex-shrink: 0;">
          ${svg('i-back', 14)}
          Back
        </a>
        <div style="min-width: 0; flex: 1; display: flex; align-items: center; gap: 12px;">
          <img src="${displayIcon}" alt="OS" style="width: 40px; height: 40px; object-fit: contain; border-radius: 10px; padding:6px; background:linear-gradient(135deg,rgba(99,102,241,0.12),rgba(139,92,246,0.06)); border:1px solid rgba(99,102,241,0.2);" onerror="this.src='https://i.imgur.com/wu0Ob6B.png';">
          <div style="min-width: 0; flex: 1;">
            <h1 class="page-title" style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin:0;">
              ${escHtml(vm.vm_name)}
            </h1>
            <p style="font-size: 12px; color: var(--text-muted); margin-top: 3px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
              <span style="background:rgba(99,102,241,0.1); color:#6366F1; padding:2px 8px; border-radius:5px; font-family:monospace; font-weight:600;">#${vm.vm_id}</span>
              <span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span>
              <span style="opacity:0.6;">·</span>
              <span style="display:inline-flex;align-items:center;gap:4px;">${svg('i-server', 11)} ${vm.node_name || 'localhost'}</span>
            </p>
          </div>
        </div>
      </div>
      <div class="page-actions" style="align-items:center;">
        <span class="badge ${statusCls}" style="padding: 5px 12px; font-size: 12px;">
          <span class="dot"></span> ${vm.status.toUpperCase()}
        </span>
        ${isRunning
