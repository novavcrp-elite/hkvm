<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Discord Bot Setup - HKVM Panel</title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></symbol>
    <symbol id="i-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></symbol>
    <symbol id="i-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></symbol>
    <symbol id="i-stop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></symbol>
    <symbol id="i-save" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></symbol>
  </defs>
</svg>

<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>
  <div class="admin-main">
    <%- include('../partials/admin/header') %>
    <div class="admin-content" id="pageContent">
      <div style="text-align: center; padding: 80px;">
        <div class="spinner spinner-lg" style="margin: 0 auto 16px;"></div>
        <div style="color: var(--text-muted);">Loading Discord setup...</div>
      </div>
    </div>
    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
function svg(id, size = 14) {
  return `<svg width="${size}" height="${size}"><use href="#${id}"/></svg>`;
}

function escHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

let botStatus = { running: false };

async function loadPage() {
  try {
    const [settingsRes, statusRes] = await Promise.all([
      fetch('/api/settings'),
      fetch('/api/discord/status').catch(() => ({ ok: false }))
    ]);
    const settings = settingsRes.ok ? await settingsRes.json() : {};
    botStatus = statusRes.ok ? await statusRes.json() : { running: false };
    renderPage(settings);
  } catch(e) {
    document.getElementById('pageContent').innerHTML = `
      <div class="empty-state">
        <div class="empty-state-icon" style="color:#EF4444;">${svg('i-alert', 48)}</div>
        <div class="empty-state-title">Failed to Load</div>
        <div class="empty-state-desc">${escHtml(e.message)}</div>
      </div>`;
  }
}

function renderPage(settings) {
  const isRunning = botStatus.running;
  const token = settings.discord_bot_token || '';
  const appId = settings.discord_app_id || '';
  const guildId = settings.discord_guild_id || '';
  const prefix = settings.discord_prefix || '!';

  document.getElementById('pageContent').innerHTML = `
    <div class="page-header" style="align-items:center;">
      <div style="display: flex; align-items: center; gap: 14px; flex: 1;">
        <a href="/dashboard" style="color: var(--text-muted); text-decoration: none; display: inline-flex; align-items: center; gap: 4px; font-size: 13px;">
          ${svg('i-back', 14)} Back
        </a>
        <div>
          <h1 class="page-title">${svg('i-terminal', 18)} Discord Bot Setup</h1>
          <p style="font-size: 12px; color: var(--text-muted); margin-top: 3px;">
            Configure your Discord bot for VM management
          </p>
        </div>
      </div>
    </div>

    <!-- Status Card -->
    <div class="card" style="margin-bottom: 20px;">
      <div class="card-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-weight: 700; font-size: 14px;">Bot Status</span>
        </div>
        <div id="botStatusBadge" style="font-size: 12px;">
          <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; font-weight: 600; ${isRunning ? 'background: rgba(16,185,129,0.12); color: #10B981;' : 'background: rgba(107,114,128,0.12); color: #6B7280;'}">
            <span style="width: 6px; height: 6px; border-radius: 50%; background: ${isRunning ? '#10B981' : '#6B7280'}; ${isRunning ? 'animation: pulse 2s infinite;' : ''}"></span>
            ${isRunning ? 'Running' : 'Stopped'}
          </span>
        </div>
      </div>
      <div class="card-body">
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button class="btn btn-primary" onclick="startBot()" id="startBtn" ${isRunning ? 'disabled' : ''} style="flex: 1; min-width: 120px; justify-content: center;">
            ${svg('i-play', 14)} Start Bot
          </button>
          <button class="btn btn-danger" onclick="stopBot()" id="stopBtn" ${!isRunning ? 'disabled' : ''} style="flex: 1; min-width: 120px; justify-content: center;">
            ${svg('i-stop', 14)} Stop Bot
          </button>
        </div>
        <div id="botLog" style="margin-top: 16px; background: #0a0a0f; border: 1px solid var(--border-subtle); border-radius: 8px; padding: 12px; font-family: monospace; font-size: 12px; color: #10B981; max-height: 150px; overflow-y: auto; display: ${isRunning ? 'block' : 'none'};">
          <div style="color: var(--text-muted);">Bot logs will appear here...</div>
        </div>
      </div>
    </div>

    <!-- Configuration Card -->
    <div class="card" style="margin-bottom: 20px;">
      <div class="card-header">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="font-weight: 700; font-size: 14px;">Bot Configuration</span>
        </div>
      </div>
      <div class="card-body">
        <form id="discordForm" onsubmit="saveConfig(event)">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Bot Token</label>
              <input type="password" id="botToken" value="${escHtml(token)}" placeholder="Enter your Discord bot token"
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-card); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;">
              <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Get from <a href="https://discord.com/developers/applications" target="_blank" style="color: var(--accent-primary);">Discord Developer Portal</a></div>
            </div>
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Application ID</label>
              <input type="text" id="appId" value="${escHtml(appId)}" placeholder="Your Discord Application ID"
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-card); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;">
            </div>
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Guild (Server) ID</label>
              <input type="text" id="guildId" value="${escHtml(guildId)}" placeholder="Discord Server ID (optional)"
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-card); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;">
            </div>
            <div>
              <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Command Prefix</label>
              <input type="text" id="prefix" value="${escHtml(prefix)}" placeholder="!" maxlength="5"
                style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-card); color: var(--text-primary); font-size: 13px; outline: none; box-sizing: border-box;">
            </div>
          </div>

          <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
            <button type="submit" class="btn btn-primary" id="saveBtn" style="justify-content: center;">
              ${svg('i-save', 14)} Save Configuration
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Setup Guide -->
    <div class="card">
      <div class="card-header">
        <span style="font-weight: 700; font-size: 14px;">Setup Guide</span>
      </div>
      <div class="card-body">
        <div style="font-size: 13px; color: var(--text-secondary); line-height: 1.8;">
          <ol style="margin: 0; padding-left: 20px;">
            <li>Go to <a href="https://discord.com/developers/applications" target="_blank" style="color: var(--accent-primary);">Discord Developer Portal</a></li>
            <li>Click <strong>New Application</strong> and give it a name</li>
            <li>Go to <strong>Bot</strong> section and click <strong>Add Bot</strong></li>
            <li>Copy the <strong>Bot Token</strong> and paste above</li>
            <li>Copy the <strong>Application ID</strong> from General Information</li>
            <li>Enable <strong>Message Content Intent</strong> under Privileged Gateway Intents</li>
            <li>Invite bot with: <code style="background: rgba(99,102,241,0.1); padding: 2px 6px; border-radius: 4px;">https://discord.com/api/oauth2/authorize?client_id=YOUR_APP_ID&scope=bot+applications.commands&permissions=8</code></li>
            <li>Save configuration and click <strong>Start Bot</strong></li>
          </ol>
        </div>
      </div>
    </div>
  `;
}

async function saveConfig(e) {
  e.preventDefault();
  const btn = document.getElementById('saveBtn');
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner" style="width:14px;height:14px;"></span> Saving...`;

  try {
    const data = {
      discord_bot_token: document.getElementById('botToken').value,
      discord_app_id: document.getElementById('appId').value,
      discord_guild_id: document.getElementById('guildId').value,
      discord_prefix: document.getElementById('prefix').value || '!'
    };

    const res = await fetch('/api/settings', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });

    const result = await res.json();
    if (!res.ok) throw new Error(result.error || (result.errors ? result.errors.map(e=>e.error).join(', ') : 'Failed to save'));

    showToast('Configuration saved!', 'success');
  } catch(e) {
    showToast(e.message, 'error');
  } finally {
    btn.disabled = false;
    btn.innerHTML = `${svg('i-save', 14)} Save Configuration`;
  }
}

async function startBot() {
  const btn = document.getElementById('startBtn');
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner" style="width:14px;height:14px;"></span> Starting...`;

  try {
    const res = await fetch('/api/discord/start', { method: 'POST' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to start');

    botStatus.running = true;
    showToast('Bot started successfully!', 'success');
    loadPage();
  } catch(e) {
    showToast(e.message, 'error');
    btn.disabled = false;
    btn.innerHTML = `${svg('i-play', 14)} Start Bot`;
  }
}

async function stopBot() {
  const btn = document.getElementById('stopBtn');
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner" style="width:14px;height:14px;"></span> Stopping...`;

  try {
    const res = await fetch('/api/discord/stop', { method: 'POST' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Failed to stop');

    botStatus.running = false;
    showToast('Bot stopped', 'success');
    loadPage();
  } catch(e) {
    showToast(e.message, 'error');
    btn.disabled = false;
    btn.innerHTML = `${svg('i-stop', 14)} Stop Bot`;
  }
}

loadPage();
</script>
</body>
</html>
