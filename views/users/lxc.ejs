<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'My LXC Containers - HKVM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png"><link rel="stylesheet" href="/css/admin.css">
  <style>
    .page-header-enhanced{display:flex;align-items:flex-start;justify-content:space-between;padding:0 0 20px;border-bottom:1px solid var(--border-subtle);margin-bottom:20px;flex-wrap:wrap;gap:16px}
    .page-title-enhanced{font-size:22px;font-weight:800;color:var(--text-primary);margin:0 0 6px;display:flex;align-items:center;gap:10px}
    .page-subtitle-enhanced{font-size:13px;color:var(--text-muted);display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:0}
    .live-badge{display:inline-flex;align-items:center;gap:6px;background:rgba(16,185,129,0.12);color:#10B981;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600}
    .live-badge .pulse{width:6px;height:6px;background:#10B981;border-radius:50%;animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
    .btn-refresh{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:10px;border:1px solid var(--border-color);background:var(--bg-card);color:var(--text-primary);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s}
    .btn-refresh:hover{border-color:var(--color-indigo);color:var(--color-indigo)}
    .btn-refresh.spinning svg{animation:spin .8s linear infinite}
    @keyframes spin{to{transform:rotate(360deg)}}
    .stats-enhanced{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:20px}
    .stat-card-enhanced{background:var(--bg-card);border:1px solid var(--border-card);border-radius:12px;padding:16px 18px;cursor:pointer;transition:all .25s;position:relative;overflow:hidden}
    .stat-card-enhanced::before{content:'';position:absolute;top:0;left:0;width:3px;height:100%;background:var(--accent-color, var(--color-indigo));border-radius:0 3px 3px 0;transition:width .25s}
    .stat-card-enhanced:hover,.stat-card-enhanced.active{border-color:var(--accent-color, var(--color-indigo));transform:translateY(-1px);box-shadow:0 4px 16px rgba(0,0,0,.08)}
    .stat-card-enhanced.active::before{width:5px}
    .stat-inner{display:flex;align-items:center;justify-content:space-between}
    .stat-value-enhanced{font-size:24px;font-weight:800;color:var(--text-primary);line-height:1}
    .stat-label-enhanced{font-size:12px;color:var(--text-muted);margin-top:4px;font-weight:500}
    .stat-icon-box{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb, var(--accent-color) 10%, transparent);color:var(--accent-color)}
    .filter-bar-enhanced{display:flex;gap:10px;align-items:center;margin-bottom:16px;flex-wrap:wrap}
    .search-wrap{flex:1;min-width:220px;position:relative}
    .search-icon-svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;color:var(--text-muted);pointer-events:none}
    .search-input{width:100%;padding:10px 12px 10px 38px;border:1px solid var(--border-color);border-radius:10px;background:var(--bg-card);color:var(--text-primary);font-size:13px;outline:none;transition:border-color .2s}
    .search-input:focus{border-color:var(--color-indigo)}
    .filter-select{padding:10px 14px;border:1px solid var(--border-color);border-radius:10px;background:var(--bg-card);color:var(--text-primary);font-size:13px;cursor:pointer;outline:none}
    .view-switcher{display:flex;border:1px solid var(--border-color);border-radius:10px;overflow:hidden}
    .view-btn{padding:9px 12px;border:none;background:transparent;color:var(--text-muted);cursor:pointer;transition:all .2s}
    .view-btn.active{background:var(--color-indigo);color:#fff}
    .vm-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:14px}
    .vm-card-enhanced{background:var(--bg-card);border:1px solid var(--border-card);border-radius:14px;padding:0;cursor:pointer;transition:all .25s;overflow:hidden}
    .vm-card-enhanced:hover{border-color:var(--color-indigo);transform:translateY(-2px);box-shadow:0 8px 30px rgba(0,0,0,.1)}
    .vm-card-enhanced.running{border-left:3px solid #10B981}
    .vm-card-enhanced.stopped{border-left:3px solid #6B7280}
    .vm-card-header{display:flex;align-items:center;justify-content:space-between;padding:16px 18px 12px;border-bottom:1px solid var(--border-subtle)}
    .vm-title-block{display:flex;align-items:center;gap:12px;min-width:0;flex:1}
    .vm-os-icon{width:40px;height:40px;border-radius:10px;background:rgba(99,102,241,0.1);display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
    .vm-os-icon img{width:100%;height:100%;object-fit:cover;border-radius:10px}
    .vm-name-enhanced{font-size:14px;font-weight:700;color:var(--text-primary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .vm-meta-enhanced{display:flex;align-items:center;gap:6px;font-size:11px;color:var(--text-muted);margin-top:2px}
    .vm-id-chip{background:rgba(99,102,241,0.1);color:#6366F1;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:600}
    .status-badge{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:600;text-transform:uppercase}
    .status-badge.running{background:rgba(16,185,129,0.12);color:#10B981}
    .status-badge.stopped{background:rgba(107,114,128,0.12);color:#9CA3AF}
    .status-badge.error{background:rgba(239,68,68,0.12);color:#EF4444}
    .status-dot{width:6px;height:6px;border-radius:50%;background:currentColor}
    .vm-specs{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--border-subtle);margin:0}
    .spec-item{display:flex;align-items:center;gap:8px;padding:10px 14px;background:var(--bg-card)}
    .spec-icon-mini{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
    .spec-icon-mini.mem{background:rgba(16,185,129,0.1);color:#10B981}
    .spec-icon-mini.cpu{background:rgba(236,72,153,0.1);color:#EC4899}
    .spec-icon-mini.disk{background:rgba(6,182,212,0.1);color:#06B6D4}
    .spec-icon-mini.net{background:rgba(245,158,11,0.1);color:#F59E0B}
    .spec-label{font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:600}
    .spec-value{font-size:12px;color:var(--text-primary);font-weight:600}
    .vm-actions-enhanced{display:flex;gap:6px;padding:12px 14px;flex-wrap:wrap;border-top:1px solid var(--border-subtle)}
    .btn-action{display:inline-flex;align-items:center;gap:5px;padding:6px 12px;border-radius:8px;border:1px solid var(--border-color);background:transparent;color:var(--text-secondary);font-size:11px;font-weight:600;cursor:pointer;transition:all .2s;text-decoration:none}
    .btn-action:hover{border-color:var(--color-indigo);color:var(--color-indigo)}
    .btn-action.start{border-color:rgba(16,185,129,0.3);color:#10B981}
    .btn-action.start:hover{background:rgba(16,185,129,0.1)}
    .btn-action.stop{border-color:rgba(239,68,68,0.3);color:#EF4444}
    .btn-action.stop:hover{background:rgba(239,68,68,0.1)}
    .btn-action.primary{border-color:rgba(99,102,241,0.3);color:#6366F1}
    .btn-action.primary:hover{background:rgba(99,102,241,0.1)}
    .vm-table-wrap{background:var(--bg-card);border:1px solid var(--border-card);border-radius:14px;overflow:hidden}
    .vm-table{width:100%;border-collapse:collapse}
    .vm-table th{padding:12px 16px;text-align:left;font-size:11px;text-transform:uppercase;font-weight:700;color:var(--text-muted);border-bottom:1px solid var(--border-card);background:var(--bg-card)}
    .vm-table td{padding:12px 16px;border-bottom:1px solid var(--border-subtle);font-size:13px;vertical-align:middle}
    .vm-table tr:last-child td{border-bottom:none}
    .vm-table tr:hover td{background:rgba(99,102,241,0.03)}
    .vm-name-link{color:var(--text-primary);font-weight:600;text-decoration:none;transition:color .2s}
    .vm-name-link:hover{color:var(--color-indigo)}
    .empty-enhanced{text-align:center;padding:60px 20px}
    .empty-icon-wrap{width:64px;height:64px;border-radius:16px;margin:0 auto 16px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg, rgba(99,102,241,0.12), rgba(99,102,241,0.04));color:#6366F1}
    .empty-icon-wrap svg{width:28px;height:28px}
    .empty-title{font-size:16px;font-weight:700;color:var(--text-primary);margin-bottom:6px}
    .empty-desc{font-size:13px;color:var(--text-muted);margin-bottom:20px;max-width:400px;margin-left:auto;margin-right:auto}
    .toast-container{position:fixed;bottom:20px;right:20px;z-index:3000;display:flex;flex-direction:column-reverse;gap:8px}
    .toast{display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:10px;font-size:13px;font-weight:500;color:#fff;box-shadow:0 8px 30px rgba(0,0,0,.25);animation:slideInToast .3s ease-out;max-width:380px}
    .toast-success{background:linear-gradient(135deg,#10B981,#059669)}
    .toast-error{background:linear-gradient(135deg,#EF4444,#DC2626)}
    .toast-info{background:linear-gradient(135deg,#6366F1,#4F46E5)}
    .toast-icon{display:flex;align-items:center}
    .toast-message{flex:1}
    .toast-close{background:none;border:none;color:#fff;cursor:pointer;font-size:18px;opacity:.7;padding:0 0 0 8px}
    .toast-close:hover{opacity:1}
    .toast.removing{animation:slideOutToast .3s ease-in forwards}
    @keyframes slideInToast{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}
    @keyframes slideOutToast{from{transform:translateX(0);opacity:1}to{transform:translateX(100%);opacity:0}}
    @keyframes slideInModal{from{transform:scale(.95);opacity:0}to{transform:scale(1);opacity:1}}
    .icon{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  </style>
</head>
<body>

<svg style="display:none">
