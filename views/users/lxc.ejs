<div class="admin-wrapper">
  <%- include('../partials/users/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- Enhanced Header -->
      <div class="page-header-enhanced">
        <div style="position: relative; z-index: 1;">
          <h1 class="page-title-enhanced">
            My LXC Containers
          </h1>
          <p class="page-subtitle-enhanced">
            Manage and monitor your assigned LXC containers
            <span class="live-badge"><span class="pulse"></span>Live · Auto-refresh 30s</span>
            <span id="lastUpdate" style="opacity: 0.7;"></span>
          </p>
        </div>
        <div style="position: relative; z-index: 1; display: flex; gap: 10px;">
          <button class="btn-refresh" onclick="syncFromServer()" style="border-color: rgba(245,158,11,0.3); color: #F59E0B;">
            <svg class="icon"><use href="#i-refresh"/></svg>
            Sync from Server
          </button>
          <button class="btn-refresh" id="refreshBtn" onclick="loadLXC()">
            <svg class="icon"><use href="#i-refresh"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-enhanced">
        <div class="stat-card-enhanced" style="--accent-color: var(--color-indigo);" onclick="quickFilter('')" data-filter="">
          <div class="stat-inner">
            <div>
              <div class="stat-value-enhanced" id="totalCount">—</div>
              <div class="stat-label-enhanced">Total Containers</div>
            </div>
            <div class="stat-icon-box"><svg class="icon"><use href="#i-server"/></svg></div>
          </div>
        </div>
        <div class="stat-card-enhanced" style="--accent-color: var(--color-emerald);" onclick="quickFilter('running')" data-filter="running">
          <div class="stat-inner">
            <div>
              <div class="stat-value-enhanced" id="runningCount">—</div>
              <div class="stat-label-enhanced">Running</div>
            </div>
            <div class="stat-icon-box"><svg class="icon"><use href="#i-play"/></svg></div>
          </div>
        </div>
        <div class="stat-card-enhanced" style="--accent-color: var(--color-gray);" onclick="quickFilter('stopped')" data-filter="stopped">
          <div class="stat-inner">
            <div>
              <div class="stat-value-enhanced" id="stoppedCount">—</div>
              <div class="stat-label-enhanced">Stopped</div>
            </div>
            <div class="stat-icon-box"><svg class="icon"><use href="#i-stop"/></svg></div>
          </div>
        </div>
        <div class="stat-card-enhanced" style="--accent-color: var(--color-cyan);">
          <div class="stat-inner">
            <div>
              <div class="stat-value-enhanced" id="totalMemory">—</div>
              <div class="stat-label-enhanced">Total RAM</div>
            </div>
            <div class="stat-icon-box"><svg class="icon"><use href="#i-mem"/></svg></div>
          </div>
        </div>
      </div>

      <!-- Filter Bar -->
      <div class="filter-bar-enhanced">
        <div class="search-wrap">
          <svg class="search-icon-svg"><use href="#i-search"/></svg>
          <input type="text" class="search-input" id="lxcSearch" placeholder="Search by name, ID, OS, or IP..." oninput="renderLXC()">
        </div>
        <select class="filter-select" id="statusFilter" onchange="renderLXC()">
          <option value="">All Status</option>
          <option value="running">🟢 Running</option>
          <option value="stopped">⚫ Stopped</option>
        </select>
        <div class="view-switcher">
          <button class="view-btn" id="viewGrid" onclick="setView('grid')" title="Grid view">
            <svg class="icon"><use href="#i-grid"/></svg>
          </button>
          <button class="view-btn active" id="viewList" onclick="setView('list')" title="List view">
            <svg class="icon"><use href="#i-list"/></svg>
          </button>
        </div>
      </div>

      <!-- LXC Container -->
      <div id="lxcContainer">
        <div class="vm-grid">
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
          <div class="skeleton-card"></div>
        </div>
      </div>

    </div>

    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
let allLXC = [];
let currentView = 'list';

function formatMem(mem) {
  if (!mem) return '—';
  return mem >= 1024 ? (mem / 1024).toFixed(1) + ' GB' : mem + ' MB';
}

function formatTime() {
  return new Date().toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

function setView(view) {
  currentView = view;
  document.getElementById('viewGrid').classList.toggle('active', view === 'grid');
  document.getElementById('viewList').classList.toggle('active', view === 'list');
  renderLXC();
}

function quickFilter(status) {
  document.getElementById('statusFilter').value = status;
  document.querySelectorAll('.stat-card-enhanced[data-filter]').forEach(c => {
    c.classList.toggle('active', c.dataset.filter === status);
  });
  renderLXC();
}

async function syncFromServer() {
  try {
    showToast('Syncing containers from server...', 'info');
    const res = await fetch('/api/lxc/sync', { method: 'POST' });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Sync failed');
    showToast(`Sync complete: ${data.imported} imported, ${data.updated} updated`, 'success');
    loadLXC();
  } catch(e) {
    showToast(e.message, 'error');
  }
}

async function loadLXC() {
  const btn = document.getElementById('refreshBtn');
  btn.classList.add('spinning');

  try {
    const res = await fetch('/api/lxc');
    if (!res.ok) throw new Error('Failed to fetch containers');
    allLXC = await res.json();

    const total = allLXC.length;
    const running = allLXC.filter(c => c.status === 'running').length;
    const stopped = allLXC.filter(c => c.status === 'stopped').length;
    const totalMem = allLXC.reduce((s, c) => s + (c.memory || 0), 0);

    animateNumber('totalCount', total);
    animateNumber('runningCount', running);
    animateNumber('stoppedCount', stopped);
    document.getElementById('totalMemory').textContent = formatMem(totalMem);
    document.getElementById('lastUpdate').textContent = `· Updated ${formatTime()}`;

    renderLXC();
  } catch(e) {
    document.getElementById('lxcContainer').innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap" style="color: var(--color-red); background: linear-gradient(135deg, var(--color-red-light), rgba(239,68,68,0.05));">
          <svg class="icon"><use href="#i-alert"/></svg>
        </div>
        <div class="empty-title">Failed to Load Containers</div>
        <div class="empty-desc">${escHtml(e.message)}</div>
        <button class="btn-refresh" onclick="loadLXC()">
          <svg class="icon"><use href="#i-refresh"/></svg> Try Again
        </button>
      </div>`;
    showToast('Failed to load containers: ' + e.message, 'error');
  } finally {
    setTimeout(() => btn.classList.remove('spinning'), 500);
  }
}

function getFilteredLXC() {
  const q = document.getElementById('lxcSearch')?.value.toLowerCase() || '';
  const status = document.getElementById('statusFilter')?.value || '';

  return allLXC.filter(c => {
    const matchQ = !q ||
      c.name?.toLowerCase().includes(q) ||
      String(c.id).includes(q) ||
      c.os_type?.toLowerCase().includes(q) ||
      c.template_key?.toLowerCase().includes(q) ||
      c.ipv4_address?.includes(q);
    const matchStatus = !status || c.status === status;
    return matchQ && matchStatus;
  });
}

function renderLXC() {
  const filtered = getFilteredLXC();
  const container = document.getElementById('lxcContainer');

  if (allLXC.length === 0) {
    container.innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap"><svg class="icon"><use href="#i-server"/></svg></div>
        <div class="empty-title">No LXC Containers</div>
        <div class="empty-desc">You don't have any containers assigned yet. Contact your administrator to request containers.</div>
      </div>`;
    return;
  }

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap"><svg class="icon"><use href="#i-search"/></svg></div>
        <div class="empty-title">No Containers Found</div>
        <div class="empty-desc">No containers match your search criteria. Try a different filter.</div>
      </div>`;
    return;
  }

  if (currentView === 'grid') {
    renderGridView(filtered, container);
  } else {
    renderListView(filtered, container);
  }
}

function renderGridView(containers, container) {
  container.innerHTML = `
    <div class="vm-grid">
      ${containers.map(c => renderLXCCard(c)).join('')}
    </div>`;
}

