                    </label>
                  </div>
                  <div class="radio-card">
                    <input type="radio" name="_mem_preset" id="mem16384" value="16384" onclick="setMem(16384)">
                    <label for="mem16384" class="radio-card-label">
                      <div class="radio-card-icon" style="color:#10B981;"><svg width="20" height="20"><use href="#i-mem"/></svg></div>
