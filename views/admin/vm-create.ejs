<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Create VM - HKVM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<!-- ============ SVG ICON SPRITE ============ -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="i-back" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></symbol>
    <symbol id="i-forward" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></symbol>
    <symbol id="i-wand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4V2M15 16v-2M8 9h2M20 9h2M17.8 11.8L19 13M15 9h.01M17.8 6.2L19 5M3 21l9-9M12.2 6.2L11 5"/></symbol>
    <symbol id="i-server" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="7" rx="2"/><rect x="2" y="14" width="20" height="7" rx="2"/><line x1="6" y1="6.5" x2="6.01" y2="6.5"/><line x1="6" y1="17.5" x2="6.01" y2="17.5"/></symbol>
    <symbol id="i-disc" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-key" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></symbol>
    <symbol id="i-user" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
    <symbol id="i-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-preview" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></symbol>
    <symbol id="i-cpu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/></symbol>
    <symbol id="i-mem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></symbol>
    <symbol id="i-network" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></symbol>
    <symbol id="i-port" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="8" width="20" height="12" rx="2"/><line x1="6" y1="14" x2="6.01" y2="14"/><line x1="10" y1="14" x2="10.01" y2="14"/><line x1="14" y1="14" x2="14.01" y2="14"/></symbol>
    <symbol id="i-map" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></symbol>
    <symbol id="i-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></symbol>
    <symbol id="i-settings" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></symbol>
    <symbol id="i-tools" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></symbol>
    <symbol id="i-bolt" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></symbol>
    <symbol id="i-note" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></symbol>
    <symbol id="i-clipboard" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a2 2 0 0 1 2 2v2H7V4a2 2 0 0 1 2-2z"/><rect x="4" y="6" width="16" height="16" rx="2"/></symbol>
    <symbol id="i-rocket" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></symbol>
    <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></symbol>
    <symbol id="i-check-circle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></symbol>
    <symbol id="i-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></symbol>
    <symbol id="i-alert" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></symbol>
    <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></symbol>
    <symbol id="i-bulb" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="9" y1="18" x2="15" y2="18"/><line x1="10" y1="22" x2="14" y2="22"/><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"/></symbol>
    <symbol id="i-pen" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/></symbol>
    <symbol id="i-play-c" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8" fill="currentColor"/></symbol>
  </defs>
</svg>

<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- Page Header -->
      <div class="page-header">
        <div class="page-title-section">
          <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
            <a href="/admin/vms" style="color: var(--text-muted); text-decoration: none; font-size: 13px; display: inline-flex; align-items: center; gap: 4px;">
              <svg width="14" height="14"><use href="#i-back"/></svg>
              Back to VMs
            </a>
          </div>
          <h1 class="page-title">
            <span class="title-icon" style="color:#EC4899;"><svg width="22" height="22"><use href="#i-wand"/></svg></span>
            Create Virtual Machine
          </h1>
          <p class="page-subtitle">Configure and deploy a new QEMU/KVM virtual machine</p>
        </div>
        <div class="page-actions">
          <div id="createStatus" style="font-size: 12px; color: var(--text-muted);"></div>
        </div>
      </div>

      <!-- Wizard Steps -->
      <div class="wizard-steps" style="margin-bottom: 28px;">
        <div class="wizard-step active" id="step-1-indicator">
          <div class="wizard-step-item">
            <div class="wizard-step-num">1</div>
            <div class="wizard-step-label">Template</div>
          </div>
        </div>
        <div class="wizard-connector" id="conn-1"></div>
        <div class="wizard-step" id="step-2-indicator">
          <div class="wizard-step-item">
            <div class="wizard-step-num">2</div>
            <div class="wizard-step-label">Hardware</div>
          </div>
        </div>
        <div class="wizard-connector" id="conn-2"></div>
        <div class="wizard-step" id="step-3-indicator">
          <div class="wizard-step-item">
            <div class="wizard-step-num">3</div>
            <div class="wizard-step-label">Network</div>
          </div>
        </div>
        <div class="wizard-connector" id="conn-3"></div>
        <div class="wizard-step" id="step-4-indicator">
          <div class="wizard-step-item">
            <div class="wizard-step-num">4</div>
            <div class="wizard-step-label">Advanced</div>
          </div>
        </div>
        <div class="wizard-connector" id="conn-4"></div>
        <div class="wizard-step" id="step-5-indicator">
          <div class="wizard-step-item">
            <div class="wizard-step-num">5</div>
            <div class="wizard-step-label">Review</div>
          </div>
        </div>
      </div>

      <form id="createVMForm">

      <!-- ============ STEP 1: TEMPLATE ============ -->
      <div id="step-1" class="wizard-page">
        <div style="display: grid; grid-template-columns: 1fr 360px; gap: 20px;">
          <div>
            <div class="card">
              <div class="card-header">
                <div class="card-title">
                  <span style="color:#6366F1;display:inline-flex;"><svg width="18" height="18"><use href="#i-server"/></svg></span>
                  Select OS Template
                </div>
              </div>
              <div class="card-body">
                <div class="form-group">
                  <label class="form-label">VM Name <span class="required">*</span></label>
                  <input type="text" class="form-control" id="vm_name" name="vm_name" placeholder="e.g., web-server-01" required>
                  <div class="form-hint">Lowercase letters, numbers, hyphens. Must be unique.</div>
                </div>
                
                <div class="form-group">
                  <label class="form-label">Hostname</label>
                  <input type="text" class="form-control" id="hostname" name="hostname" placeholder="e.g., web-server">
                </div>

                <div class="form-group">
                  <label class="form-label">OS Template <span class="required">*</span></label>
                  <div class="template-grid" id="templateGrid">
                    <div style="padding: 20px; text-align: center; grid-column: 1/-1;">
                      <div class="spinner" style="margin: 0 auto;"></div>
                    </div>
                  </div>
                  <input type="hidden" id="os_template" name="os_template">
                </div>

                <div style="margin-top: 16px; padding: 14px; background: rgba(99, 102, 241, 0.06); border-radius: var(--radius-md); border: 1px solid rgba(99, 102, 241, 0.15);">
                  <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 10px; display:flex; align-items:center; gap:6px;">
                    <span style="color:#6366F1; display:inline-flex;"><svg width="12" height="12"><use href="#i-info"/></svg></span>
                    Template Details
                  </div>
                  <div id="templateDetails" style="font-size: 13px; color: var(--text-muted);">Select a template above to see details</div>
                </div>
              </div>
            </div>

            <!-- Custom ISO Section -->
            <div class="card" style="margin-top: 16px;">
              <div class="card-header">
                <div class="card-title">
                  <span style="color:#06B6D4;display:inline-flex;"><svg width="18" height="18"><use href="#i-disc"/></svg></span>
                  Or Use ISO File
                </div>
              </div>
              <div class="card-body">
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label">ISO File (leave empty to use template above)</label>
                  <select class="form-control" id="iso_file" name="iso_file" onchange="handleIsoSelect()">
                    <option value="">— Use OS Template —</option>
                  </select>
                  <div class="form-hint">ISO files from the /iso directory will appear here</div>
                </div>
              </div>
            </div>
          </div>

          <!-- Right: Credentials -->
          <div>
            <div class="card">
              <div class="card-header">
                <div class="card-title">
                  <span style="color:#F59E0B;display:inline-flex;"><svg width="18" height="18"><use href="#i-key"/></svg></span>
                  Credentials
                </div>
              </div>
              <div class="card-body">
                <div class="form-group">
                  <label class="form-label">Username</label>
                  <input type="text" class="form-control" id="custom_username" name="custom_username" placeholder="Default from template" oninput="validateUsername()">
                  <div class="form-hint" id="usernameHint" style="display:flex;align-items:center;gap:6px;">
                    <span style="color:#3B82F6;display:inline-flex;"><svg width="12" height="12"><use href="#i-info"/></svg></span>
                    Leave empty to use template default. Can use "root" for root access.
                  </div>
                </div>
                <div class="form-group">
                  <label class="form-label">Password</label>
                  <div style="position: relative;">
                    <input type="password" class="form-control" id="custom_password" name="custom_password" placeholder="Default from template" style="padding-right: 40px;">
                    <button type="button" onclick="togglePw('custom_password', this)" style="position:absolute; right:10px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer; display:inline-flex;">
                      <svg width="16" height="16"><use href="#i-eye"/></svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>

            <!-- VM Owner -->
            <div class="card" style="margin-top: 16px;">
              <div class="card-header">
                <div class="card-title">
                  <span style="color:#8B5CF6;display:inline-flex;"><svg width="18" height="18"><use href="#i-user"/></svg></span>
                  VM Owner
                </div>
              </div>
              <div class="card-body">
                <div class="form-group" style="margin-bottom: 0;">
                  <label class="form-label">Assign to User <span class="required">*</span></label>
                  <select class="form-control" id="owner_id" name="owner_id" required onchange="updatePreview()">
                    <option value="">— Select User —</option>
                  </select>
                  <div class="form-hint">VM will be owned and managed by this user</div>
                </div>
              </div>
            </div>

            <!-- Quick Preview -->
            <div class="card" style="margin-top: 16px;">
              <div class="card-header">
                <div class="card-title">
                  <span style="color:#10B981;display:inline-flex;"><svg width="18" height="18"><use href="#i-preview"/></svg></span>
                  Configuration Preview
                </div>
              </div>
              <div class="card-body">
                <div id="configPreview" style="font-size: 12px; color: var(--text-muted); font-family: monospace; background: #0a0a12; padding: 12px; border-radius: 8px; line-height: 1.8;">
                  <div>VM Name: <span id="prev_name" style="color: #a5f3fc;">—</span></div>
                  <div>OS: <span id="prev_os" style="color: #a5f3fc;">—</span></div>
                  <div>RAM: <span id="prev_ram" style="color: #a5f3fc;">—</span></div>
                  <div>CPU: <span id="prev_cpu" style="color: #a5f3fc;">—</span></div>
                  <div>Disk: <span id="prev_disk" style="color: #a5f3fc;">—</span></div>
                  <div>Network: <span id="prev_net" style="color: #a5f3fc;">—</span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ============ STEP 2: HARDWARE ============ -->
      <div id="step-2" class="wizard-page" style="display: none;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="card">
            <div class="card-header">
              <div class="card-title">
                <span style="color:#EC4899;display:inline-flex;"><svg width="18" height="18"><use href="#i-cpu"/></svg></span>
                CPU Configuration
              </div>
            </div>
            <div class="card-body">
              <div class="form-row">
                <div class="form-group">
                  <label class="form-label">CPU Sockets</label>
                  <input type="number" class="form-control" name="cpu_sockets" id="cpu_sockets" value="1" min="1" max="16" onchange="updateTotalCPU()">
                </div>
                <div class="form-group">
                  <label class="form-label">Cores per Socket</label>
                  <input type="number" class="form-control" name="cpu_cores" id="cpu_cores" value="2" min="1" max="64" onchange="updateTotalCPU()">
                </div>
                <div class="form-group">
                  <label class="form-label">Threads per Core</label>
                  <select class="form-control" name="cpu_threads" id="cpu_threads" onchange="updateTotalCPU()">
                    <option value="1">1 (Single)</option>
                    <option value="2">2 (HyperThreading)</option>
                  </select>
                </div>
              </div>
              
              <div style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; background: rgba(99, 102, 241, 0.06); border-radius: 8px; margin: 8px 0 16px; border: 1px solid rgba(99, 102, 241, 0.15);">
                <span style="width:36px;height:36px;border-radius:8px;background:rgba(99,102,241,0.15);color:#6366F1;display:inline-flex;align-items:center;justify-content:center;"><svg width="18" height="18"><use href="#i-cpu"/></svg></span>
                <div style="flex:1;">
                  <div style="font-size: 11px; color: var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Total vCPUs</div>
                  <div style="font-size: 22px; font-weight: 700; color: var(--accent-primary);" id="totalCPUDisplay">2</div>
                </div>
                <input type="hidden" name="custom_cpus" id="custom_cpus" value="2">
              </div>

              <div class="form-group" style="margin-bottom: 0;">
                <label class="form-label">CPU Model</label>
                <select class="form-control" name="cpu_model" id="cpu_model">
                  <!-- Loaded dynamically -->
                </select>
                <div class="form-hint">Use 'host' for best performance on physical hardware</div>
              </div>

              <div style="margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--border-subtle);">
                <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
                  <input type="checkbox" class="form-check-input" id="enable_custom_cpu_name" name="enable_custom_cpu_name" onchange="toggleCustomCPUName()" style="cursor: pointer; width: 20px; height: 20px;">
                  <label for="enable_custom_cpu_name" class="form-label" style="margin: 0; cursor: pointer; flex: 1;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: #6366F1;">
                      <svg width="14" height="14"><use href="#i-cpu"/></svg>
                      <span>Use Custom CPU Name</span>
                      <span style="font-size: 11px; color: var(--text-muted); font-weight: normal; background: rgba(99, 102, 241, 0.1); padding: 2px 8px; border-radius: 4px;">Optional</span>
                    </span>
                  </label>
                </div>
                <div id="custom_cpu_name_section" style="display: none; padding: 14px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(99, 102, 241, 0.03) 100%); border-radius: 8px; border: 1.5px solid rgba(99, 102, 241, 0.2);">
                  <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label" style="display: inline-flex; align-items: center; gap: 6px;">
                      <span style="color:#6366F1;display:inline-flex;"><svg width="13" height="13"><use href="#i-pen"/></svg></span>
