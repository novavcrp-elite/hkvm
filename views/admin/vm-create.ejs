</div>

<script>
let currentStep = 1;
const totalSteps = 5;
let osTemplates = {};

// SVG helper for dynamic contexts
function svg(id, size = 14) {
  return `<svg width="${size}" height="${size}"><use href="#${id}"/></svg>`;
}

// Initialize
async function init() {
  await Promise.all([loadTemplates(), loadCPUModels(), loadNetworkTypes(), loadISOList(), loadUsers()]);
  updatePreview();
}

async function loadTemplates() {
  try {
    const res = await fetch('/api/os-templates');
    if (!res.ok) return;
    osTemplates = await res.json();
    
    const grid = document.getElementById('templateGrid');
    if (!grid) return;
    
    grid.innerHTML = Object.entries(osTemplates).map(([key, tmpl]) => {
      const iconUrl = tmpl.icon && tmpl.icon.startsWith('http') ? tmpl.icon : 'https://i.imgur.com/wu0Ob6B.png';
      const iconHtml = `<img src="${iconUrl}" style="width: 48px; height: 48px; object-fit: contain; border-radius: 8px; padding:4px; background:rgba(99,102,241,0.05);" onerror="this.src='https://i.imgur.com/wu0Ob6B.png';" alt="${tmpl.name}">`;
      return `
      <label class="template-card">
        <input type="radio" name="_template" value="${key}" onchange="selectTemplate('${key}')">
        <div class="template-card-inner">
          <div class="template-icon">${iconHtml}</div>
          <div class="template-name">${tmpl.name}</div>
          <div class="template-type">${tmpl.type}</div>
        </div>
      </label>`;
    }).join('');
    
    const first = Object.keys(osTemplates)[0];
    if (first) document.querySelector(`input[value="${first}"]`)?.click();
  } catch(e) { console.log('Templates load error:', e); }
}

function selectTemplate(key) {
  const tmpl = osTemplates[key];
  if (!tmpl) return;
  
  document.getElementById('os_template').value = key;
  document.getElementById('iso_file').value = '';
  
  const details = document.getElementById('templateDetails');
  if (details) {
    details.innerHTML = `
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
        <div style="font-size: 12px; color: var(--text-muted);">Type:</div><div style="font-size: 12px; color: var(--text-primary); font-weight:500;">${tmpl.type}</div>
        <div style="font-size: 12px; color: var(--text-muted);">Default RAM:</div><div style="font-size: 12px; color: var(--text-primary); font-weight:500;">${tmpl.memory}MB</div>
        <div style="font-size: 12px; color: var(--text-muted);">Default CPUs:</div><div style="font-size: 12px; color: var(--text-primary); font-weight:500;">${tmpl.cpus} vCPUs</div>
        <div style="font-size: 12px; color: var(--text-muted);">Disk:</div><div style="font-size: 12px; color: var(--text-primary); font-weight:500;">${tmpl.disk_size}</div>
        <div style="font-size: 12px; color: var(--text-muted);">Username:</div><div style="font-size: 12px; color: var(--accent-primary); font-weight:600;">${tmpl.username}</div>
      </div>`;
  }
  
  if (document.getElementById('custom_memory').value === '2048' || !document.getElementById('custom_memory').value) {
    document.getElementById('custom_memory').value = tmpl.memory;
  }
  updatePreview();
}

function handleIsoSelect() {
  if (document.getElementById('iso_file').value) {
    document.getElementById('os_template').value = '';
    document.querySelectorAll('input[name="_template"]').forEach(r => r.checked = false);
  }
  updatePreview();
}

async function loadCPUModels() {
  try {
    const res = await fetch('/api/cpu-models');
    if (!res.ok) return;
    const models = await res.json();
    const sel = document.getElementById('cpu_model');
    if (!sel) return;
    sel.innerHTML = Object.entries(models).map(([key, m]) =>
      `<option value="${key}" ${key === 'host' ? 'selected' : ''}>${m.name} — ${m.description}</option>`
    ).join('');
  } catch(e) {}
}

async function loadNetworkTypes() {
  try {
    const res = await fetch('/api/network-types');
    if (!res.ok) return;
    const types = await res.json();
    const grid = document.getElementById('networkTypeGrid');
    if (!grid) return;
    
    grid.innerHTML = Object.entries(types).map(([key, t], i) => `
      <div>
        <input type="radio" name="_network_type" id="net_${key}" value="${key}" ${i === 0 ? 'checked' : ''} onchange="selectNetwork('${key}')">
        <label for="net_${key}" class="network-type-inner">
          <div class="network-type-icon">${t.icon}</div>
          <div class="network-type-name">${t.name}</div>
          <div class="network-type-desc">${t.description}</div>
        </label>
      </div>`).join('');
    
    const firstKey = Object.keys(types)[0];
    if (firstKey) selectNetwork(firstKey);
  } catch(e) { console.error('Error loading network types:', e); }
}

function selectNetwork(key) {
  document.getElementById('network_type').value = key;
  const staticCard = document.getElementById('staticIpCard');
  const ipv6Card = document.getElementById('ipv6Card');
  if (staticCard) staticCard.style.display = (key === 'static_public' || key === 'static_private' || key === 'dual_stack') ? 'block' : 'none';
  if (ipv6Card) ipv6Card.style.display = (key === 'dual_stack') ? 'block' : 'none';
  updatePreview();
}

async function loadISOList() {
  try {
    const res = await fetch('/api/iso-list');
    if (!res.ok) return;
    const isos = await res.json();
    const sel = document.getElementById('iso_file');
    if (!sel) return;
    if (isos.length === 0) {
      sel.innerHTML = '<option value="">— No ISO files found —</option>';
    } else {
      sel.innerHTML = '<option value="">— Use OS Template —</option>' +
        isos.map(iso => `<option value="${iso}">${iso}</option>`).join('');
    }
  } catch(e) {}
}

async function loadUsers() {
  try {
    const res = await fetch('/api/users/list');
    if (!res.ok) return;
    const users = await res.json();
    const sel = document.getElementById('owner_id');
    if (!sel) return;
    if (users.length === 0) {
      sel.innerHTML = '<option value="">— No users available —</option>';
    } else {
      sel.innerHTML = '<option value="">— Select User —</option>' +
        users.map(user => `<option value="${user.id}">${user.username} (${user.email || 'N/A'})</option>`).join('');
    }
  } catch(e) { console.log('Error loading users:', e); }
}

function updateTotalCPU() {
  const s = parseInt(document.getElementById('cpu_sockets')?.value) || 1;
  const c = parseInt(document.getElementById('cpu_cores')?.value) || 1;
  const t = parseInt(document.getElementById('cpu_threads')?.value) || 1;
  const total = s * c * t;
  const el = document.getElementById('totalCPUDisplay');
  const hidden = document.getElementById('custom_cpus');
  if (el) el.textContent = total;
  if (hidden) hidden.value = total;
  updatePreview();
}

function updateDiskSize() {
  const num = document.getElementById('disk_size_num')?.value || '20';
  const unit = document.getElementById('disk_size_unit')?.value || 'G';
  const hidden = document.getElementById('disk_size');
  if (hidden) hidden.value = num + unit;
  updatePreview();
}

function toggleCustomCPUName() {
  const checkbox = document.getElementById('enable_custom_cpu_name');
  const section = document.getElementById('custom_cpu_name_section');
  const input = document.getElementById('custom_cpu_name');
  
  if (checkbox.checked) {
    section.style.display = 'block';
    input.required = true;
    setTimeout(() => input.focus(), 100);
  } else {
    section.style.display = 'none';
    input.required = false;
    input.value = '';
    document.getElementById('cpuNameValid').style.opacity = '0';
  }
  updatePreview();
}

function validateCustomCPUName() {
  const input = document.getElementById('custom_cpu_name');
  const validIcon = document.getElementById('cpuNameValid');
  const value = input.value.trim();
  if (value.length > 0) {
    validIcon.style.opacity = '1';
    input.style.borderColor = '#10B981';
  } else {
    validIcon.style.opacity = '0';
    input.style.borderColor = '';
  }
}

function validateUsername() {
  const input = document.getElementById('custom_username');
  const hint = document.getElementById('usernameHint');
  const value = input.value.trim();
  
  if (!value) {
    hint.innerHTML = `<span style="color:#3B82F6;display:inline-flex;">${svg('i-info', 12)}</span> Leave empty to use template default. Can use "root" for root access.`;
    hint.style.color = 'var(--text-muted)';
    input.style.borderColor = '';
    return;
  }
  
  const isValid = /^[a-zA-Z0-9_-]+$/.test(value) && value.length >= 1 && value.length <= 32;
  
  if (value.toLowerCase() === 'root') {
    hint.innerHTML = `<span style="color:#10B981;display:inline-flex;">${svg('i-check-circle', 12)}</span> Using <strong>root</strong> user - will have full system access.`;
    hint.style.color = '#10B981';
    input.style.borderColor = '#10B981';
  } else if (isValid) {
    hint.innerHTML = `<span style="color:#10B981;display:inline-flex;">${svg('i-check-circle', 12)}</span> Valid username. User will be created with sudo privileges.`;
    hint.style.color = '#10B981';
    input.style.borderColor = '#10B981';
  } else {
    hint.innerHTML = `<span style="color:#EF4444;display:inline-flex;">${svg('i-alert', 12)}</span> Invalid username. Use lowercase letters, numbers, hyphens, underscores (1-32 chars).`;
    hint.style.color = '#EF4444';
    input.style.borderColor = '#EF4444';
  }
}

function toggleCustomManufacturer() {
  const select = document.getElementById('smbios_manufacturer');
  const input = document.getElementById('custom_manufacturer');
  if (select.value === 'custom') {
    input.style.display = 'block';
    input.required = true;
    setTimeout(() => input.focus(), 100);
  } else {
    input.style.display = 'none';
    input.required = false;
    input.value = '';
  }
  updatePreview();
}

function toggleCustomProduct() {
  const select = document.getElementById('smbios_product');
  const input = document.getElementById('custom_product');
  if (select.value === 'custom') {
    input.style.display = 'block';
    input.required = true;
    setTimeout(() => input.focus(), 100);
  } else {
    input.style.display = 'none';
    input.required = false;
    input.value = '';
  }
  updatePreview();
}

function setMem(val) {
  const el = document.getElementById('custom_memory');
  if (el) el.value = val;
  updatePreview();
}

function genMAC() {
  const mac = 'fa:16:3e:' + [0,1,2].map(() =>
    Math.floor(Math.random()*256).toString(16).padStart(2,'0')
  ).join(':');
  const el = document.getElementById('mac_address');
  if (el) el.value = mac;
  showToast('MAC address generated', 'success');
}

function goToStep(step) {
  for (let i = 1; i <= totalSteps; i++) {
    const page = document.getElementById(`step-${i}`);
    const indicator = document.getElementById(`step-${i}-indicator`);
    if (page) page.style.display = i === step ? 'block' : 'none';
    if (indicator) {
      indicator.classList.remove('active', 'completed');
      if (i === step) indicator.classList.add('active');
      else if (i < step) indicator.classList.add('completed');
    }
    const conn = document.getElementById(`conn-${i}`);
    if (conn) conn.classList.toggle('done', i < step);
  }
  currentStep = step;
  document.getElementById('prevBtn').style.display = step === 1 ? 'none' : 'inline-flex';
  document.getElementById('nextBtn').style.display = step === totalSteps ? 'none' : 'inline-flex';
  if (step === totalSteps) buildReview();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function nextStep() { if (!validateStep(currentStep)) return; if (currentStep < totalSteps) goToStep(currentStep + 1); }
function prevStep() { if (currentStep > 1) goToStep(currentStep - 1); }

function validateStep(step) {
  if (step === 1) {
    const name = document.getElementById('vm_name')?.value.trim();
    if (!name) { showToast('VM Name is required', 'warning'); return false; }
    if (!/^[a-z0-9]([a-z0-9-]*[a-z0-9])?$/.test(name)) {
      showToast('VM Name must be lowercase letters, numbers, and hyphens', 'warning');
      return false;
    }
    const template = document.getElementById('os_template')?.value;
    const iso = document.getElementById('iso_file')?.value;
    if (!template && !iso) { showToast('Please select a template or ISO file', 'warning'); return false; }
    return true;
  }
  if (step === 2) {
    const mem = parseInt(document.getElementById('custom_memory')?.value);
    if (!mem || mem < 512) { showToast('Minimum 512MB RAM required', 'warning'); return false; }
    return true;
  }
  return true;
}

function buildReview() {
  const data = collectFormData();
  const el = document.getElementById('reviewContent');
  const nameEl = document.getElementById('reviewVMName');
  const osEl = document.getElementById('reviewVMOS');
  
  if (nameEl) nameEl.textContent = data.vm_name || '—';
  if (osEl) osEl.textContent = data.os_template ? (osTemplates[data.os_template]?.name || data.os_template) : (data.iso_file || 'Custom');
  
  if (el) {
    el.innerHTML = `
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <div>
          <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color:#6366F1; margin-bottom: 10px; display:inline-flex; align-items:center; gap:6px;">${svg('i-server', 12)} System</div>
          ${reviewRow('VM Name', data.vm_name)}
          ${reviewRow('Hostname', data.hostname)}
          ${reviewRow('OS Template', osTemplates[data.os_template]?.name || data.iso_file || '—')}
          ${reviewRow('Username', data.custom_username)}
          ${reviewRow('Owner', getOwnerName(data.owner_id))}
        </div>
        <div>
          <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color:#EC4899; margin-bottom: 10px; display:inline-flex; align-items:center; gap:6px;">${svg('i-cpu', 12)} Hardware</div>
          ${reviewRow('vCPUs', data.custom_cpus + ' vCPUs')}
          ${reviewRow('CPU Layout', data.cpu_sockets + 'S × ' + data.cpu_cores + 'C × ' + data.cpu_threads + 'T')}
          ${reviewRow('CPU Model', data.cpu_model || 'host')}
          ${reviewRow('Custom CPU', data.custom_cpu_name ? '<span style="color:#6366F1; font-weight:600;">' + data.custom_cpu_name + '</span>' : 'Default (host)')}
          ${reviewRow('Memory', data.custom_memory + ' MB')}
          ${reviewRow('Disk Size', data.disk_size)}
        </div>
        <div>
          <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color:#3B82F6; margin-bottom: 10px; display:inline-flex; align-items:center; gap:6px;">${svg('i-network', 12)} Network</div>
          ${reviewRow('Network Type', data.network_type)}
          ${reviewRow('SSH Port', data.ssh_port || 'Auto')}
          ${reviewRow('HTTP Port', data.http_port || '80')}
          ${reviewRow('IPv4 Address', data.ipv4_address || 'DHCP')}
        </div>
        <div>
          <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color:#F59E0B; margin-bottom: 10px; display:inline-flex; align-items:center; gap:6px;">${svg('i-tools', 12)} BIOS/Identity</div>
          ${reviewRow('Manufacturer', data.smbios_manufacturer)}
          ${reviewRow('Product', data.smbios_product)}
          ${reviewRow('ACPI', data.enable_acpi ? 'Enabled' : 'Disabled')}
        </div>
      </div>`;
  }
}

function reviewRow(label, value) {
  return `
    <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle); gap: 8px;">
      <span style="font-size: 12px; color: var(--text-muted);">${label}</span>
      <span style="font-size: 12px; color: var(--text-primary); font-weight: 500; text-align: right;">${value || '—'}</span>
    </div>`;
}

function getOwnerName(ownerId) {
  if (!ownerId) return '—';
  const option = document.getElementById('owner_id')?.querySelector(`option[value="${ownerId}"]`);
  return option?.textContent || '—';
}

function collectFormData() {
  const form = document.getElementById('createVMForm');
  const fd = new FormData(form);
  const data = {};
  fd.forEach((v, k) => { if (!k.startsWith('_')) data[k] = v; });
  
  const osTemplateInput = document.getElementById('os_template');
  if (osTemplateInput && osTemplateInput.value) data.os_template = osTemplateInput.value;
  
  data.enable_kvm = 1;
  data.enable_acpi = document.getElementById('enable_acpi')?.checked ? 1 : 0;
  
  const customCPUCheckbox = document.getElementById('enable_custom_cpu_name');
  const customCPUInput = document.getElementById('custom_cpu_name');
  if (customCPUCheckbox && customCPUCheckbox.checked && customCPUInput) {
    const cpuName = customCPUInput.value.trim();
    if (!cpuName) return null;
    data.custom_cpu_name = cpuName;
  } else {
    data.custom_cpu_name = null;
  }
  
  const manufacturerSelect = document.getElementById('smbios_manufacturer');
  if (manufacturerSelect && manufacturerSelect.value === 'custom') {
    const customManuf = document.getElementById('custom_manufacturer')?.value.trim();
    if (customManuf) data.smbios_manufacturer = customManuf;
  }
  
  const productSelect = document.getElementById('smbios_product');
  if (productSelect && productSelect.value === 'custom') {
    const customProd = document.getElementById('custom_product')?.value.trim();
    if (customProd) data.smbios_product = customProd;
  }
  
  return data;
}

async function submitCreate() {
  const btn = document.getElementById('createBtn');
  const alert = document.getElementById('createAlert');
  const progress = document.getElementById('createProgress');
  const progressBar = document.getElementById('createProgressBar');
  const progressText = document.getElementById('createProgressText');
  
  btn.disabled = true;
  btn.innerHTML = `<span class="spinner spinner-sm" style="margin-right:8px;"></span> Creating...`;
  
  alert.style.display = 'none';
  progress.style.display = 'block';
  progressText.textContent = 'Initializing...';
  progressBar.style.width = '10%';
  
  try {
    const data = collectFormData();
    if (data === null) throw new Error('Please fill in the custom CPU name field');
    if (!data.os_template && !data.iso_file) throw new Error('Please select an OS template or ISO file');
    
    progressText.textContent = 'Creating VM...';
    progressBar.style.width = '30%';
    
    const res = await fetch('/api/vms', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    progressBar.style.width = '70%';
    progressText.textContent = 'Configuring...';
    
    const result = await res.json();
    
    if (res.ok && result.success) {
      progressBar.style.width = '100%';
      progressBar.classList.add('green');
      progressText.textContent = 'VM created successfully!';
      
      alert.className = 'alert alert-success';
      alert.innerHTML = `<span class="alert-icon" style="color:#10B981; display:inline-flex;">${svg('i-check-circle', 16)}</span><span>VM "${data.vm_name}" created successfully! (ID: ${result.vm_id})</span>`;
      alert.style.display = 'flex';
      
      btn.innerHTML = `${svg('i-check', 14)} VM Created!`;
      showToast('VM created successfully!', 'success');
      
      setTimeout(() => { window.location.href = `/admin/vm/${result.vm_id}`; }, 1800);
    } else {
      throw new Error(result.error || 'VM creation failed');
    }
  } catch(e) {
    progress.style.display = 'none';
    alert.className = 'alert alert-error';
    alert.innerHTML = `<span class="alert-icon" style="color:#EF4444; display:inline-flex;">${svg('i-x', 16)}</span><span>${escHtml(e.message)}</span>`;
    alert.style.display = 'flex';
    
    btn.disabled = false;
    btn.innerHTML = `${svg('i-refresh', 14)} Try Again`;
    showToast('Failed: ' + e.message, 'error');
  }
}

function updatePreview() {
  const name = document.getElementById('vm_name')?.value || '—';
  const template = document.getElementById('os_template')?.value;
  const os = template ? (osTemplates[template]?.name || template) : (document.getElementById('iso_file')?.value || '—');
  const mem = document.getElementById('custom_memory')?.value || '2048';
  const cpus = document.getElementById('custom_cpus')?.value || '2';
  const disk = document.getElementById('disk_size')?.value || '20G';
  const net = document.getElementById('network_type')?.value || 'dhcp';
  
  // Update text preview
  if (document.getElementById('prev_name')) document.getElementById('prev_name').textContent = name;
  if (document.getElementById('prev_os')) document.getElementById('prev_os').textContent = os;
  if (document.getElementById('prev_ram')) document.getElementById('prev_ram').textContent = mem + 'MB';
  if (document.getElementById('prev_cpu')) document.getElementById('prev_cpu').textContent = cpus + ' vCPUs';
  if (document.getElementById('prev_disk')) document.getElementById('prev_disk').textContent = disk;
  if (document.getElementById('prev_net')) document.getElementById('prev_net').textContent = net;
  
  // Update OS logo in Ready to Deploy box
  const osLogoBox = document.getElementById('osLogoBox');
  if (osLogoBox && template && osTemplates[template]) {
    const tmpl = osTemplates[template];
    const iconUrl = tmpl.icon && tmpl.icon.startsWith('http') ? tmpl.icon : 'https://i.imgur.com/wu0Ob6B.png';
    osLogoBox.innerHTML = `<img src="${iconUrl}" style="width: 48px; height: 48px; object-fit: contain; border-radius: 8px; padding: 4px; background: white;" onerror="this.src='https://i.imgur.com/wu0Ob6B.png';" alt="${tmpl.name}">`;
  } else if (osLogoBox) {
    osLogoBox.innerHTML = '<svg width="30" height="30" style="color: #6366F1;"><use href="#i-server"/></svg>';
  }
}

function togglePw(id, btn) {
  const el = document.getElementById(id);
  if (!el) return;
  el.type = el.type === 'password' ? 'text' : 'password';
}

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function showToast(msg, type = 'info') {
  let container = document.getElementById('toastContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container';
    document.body.appendChild(container);
  }
  const iconMap = { success: 'i-check', error: 'i-x', warning: 'i-alert', info: 'i-info' };
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `<span class="toast-icon">${svg(iconMap[type] || 'i-info', 16)}</span><span class="toast-message">${escHtml(msg)}</span><button class="toast-close" onclick="this.parentElement.remove()">×</button>`;
  container.appendChild(toast);
  setTimeout(() => { toast.classList.add('removing'); setTimeout(() => toast.remove(), 300); }, 4500);
}

document.getElementById('vm_name')?.addEventListener('input', updatePreview);
document.getElementById('custom_memory')?.addEventListener('input', updatePreview);
document.getElementById('disk_size_num')?.addEventListener('input', updateDiskSize);

init();
goToStep(1);
</script>
</body>
</html>