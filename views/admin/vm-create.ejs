                </div>
                <div class="radio-cards" style="grid-template-columns: repeat(3, 1fr);">
                  <div class="radio-card">
                    <input type="radio" name="_mem_preset" id="mem512" value="512" onclick="setMem(512)">
                    <label for="mem512" class="radio-card-label">
                      <div class="radio-card-icon" style="color:#10B981;"><svg width="20" height="20"><use href="#i-mem"/></svg></div>
                      <div class="radio-card-title">512 MB</div>
