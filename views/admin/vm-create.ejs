                  </div>
                  <div class="radio-card">
                    <input type="radio" name="_mem_preset" id="mem8192" value="8192" onclick="setMem(8192)">
                    <label for="mem8192" class="radio-card-label">
                      <div class="radio-card-icon" style="color:#10B981;"><svg width="20" height="20"><use href="#i-mem"/></svg></div>
