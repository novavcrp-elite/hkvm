                  <div class="radio-card">
                    <input type="radio" name="_mem_preset" id="mem4096" value="4096" onclick="setMem(4096)">
                    <label for="mem4096" class="radio-card-label">
                      <div class="radio-card-icon" style="color:#10B981;"><svg width="20" height="20"><use href="#i-mem"/></svg></div>
