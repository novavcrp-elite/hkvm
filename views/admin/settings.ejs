<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Settings - HKVM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <!-- Font Awesome removed – replaced with inline SVGs (no external icon dependency) -->
  <link rel="stylesheet" href="/css/admin.css">
  <!-- dynamic accent pulse (inline micro-interaction without extra css file) -->
  <style>
    /* subtle dynamic touch – only micro-animation, no design css (everything else uses admin.css) */
    @keyframes subtlePulse { 0%{opacity:.7} 50%{opacity:1} 100%{opacity:.7} }
    .dynamic-pulse { animation: subtlePulse 2.8s ease-in-out infinite; }
    .hover-lift { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .hover-lift:hover { transform: translateY(-2px); box-shadow: 0 8px 16px rgba(0,0,0,0.08); }
    .badge-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #10b981; margin-right: 6px; }
  </style>
</head>
<body>
<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">

      <!-- Page Header (refined with svg + dynamic microcopy) -->
      <div class="page-header">
        <div class="page-title-section">
          <h1 class="page-title" style="display: flex; align-items: center; gap: 10px;">
            <span class="title-icon" style="color: var(--accent-primary);">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
            </span>
            System Settings
          </h1>
          <p class="page-subtitle" style="display: flex; align-items: center; gap: 8px;">
            <span class="dynamic-pulse" style="background: var(--accent-green); width: 8px; height: 8px; border-radius: 50%;"></span>
            Configure HKVM Panel preferences · live sync
          </p>
        </div>
        <div class="page-actions">
          <button class="btn btn-primary hover-lift" onclick="saveAllSettings()" style="display: flex; align-items: center; gap: 8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
              <polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline>
            </svg>
            Save All Settings
          </button>
        </div>
      </div>

      <div id="settingsAlert" style="display: none; margin-bottom: 16px;"></div>

      <!-- Modern Tabs with SVG icons (all icons embedded) -->
      <div class="tabs" style="gap: 6px; flex-wrap: wrap;">
        <button class="tab-btn active" onclick="switchTab('general')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          General
        </button>
        <button class="tab-btn" onclick="switchTab('branding')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          Branding
        </button>
        <button class="tab-btn" onclick="switchTab('security')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
          Security
        </button>
        <button class="tab-btn" onclick="switchTab('system')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg>
          System
        </button>
        <button class="tab-btn" onclick="switchTab('about')" style="display: flex; align-items: center; gap: 6px;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          About
        </button>
      </div>

      <!-- GENERAL TAB -->
      <div class="tab-pane active" id="tab-general">
        <!-- Site branding section with SVG -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></span>
            <div>
              <div class="settings-section-title">Site Branding</div>
            </div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Site Name</div>
                <div class="settings-row-desc">The main title shown throughout the application</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="setting_site_name" data-key="site_name" placeholder="HKVM Panel">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Site Description</div>
                <div class="settings-row-desc">Short description shown in login page and meta tags</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="setting_site_description" data-key="site_description" placeholder="Virtual Machine Management System">
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info">
                <div class="settings-row-label">Site Icon URL</div>
                <div class="settings-row-desc">Full URL to your site icon (PNG, SVG, JPG). Example: /images/icon.png</div>
              </div>
              <div class="settings-row-control">
                <input type="text" class="form-control" id="setting_site_icon_url" data-key="site_icon_url" placeholder="https://example.com/icon.png">
              </div>
            </div>
          </div>
        </div>

        <!-- General config -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg></span>
            <div><div class="settings-section-title">General Configuration</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Panel Title</div><div class="settings-row-desc">The name shown in browser title</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_panel_title" data-key="panel_title" placeholder="HKVM Panel V1.0"></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Panel Description</div><div class="settings-row-desc">Login page subtitle</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_panel_description" data-key="panel_description" placeholder="Professional VM Management"></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Panel Version</div><div class="settings-row-desc">Current version identifier</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_panel_version" data-key="panel_version" placeholder="V1.0"></div>
            </div>
          </div>
        </div>

        <!-- Session -->
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
            <div><div class="settings-section-title">Session & Access</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Session Timeout (hours)</div><div class="settings-row-desc">Auto logout interval</div></div>
              <div class="settings-row-control"><input type="number" class="form-control" id="setting_session_timeout" data-key="session_timeout" min="1" max="720" placeholder="24"></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Max Concurrent Sessions</div><div class="settings-row-desc">Per user limit</div></div>
              <div class="settings-row-control"><input type="number" class="form-control" id="setting_max_sessions" data-key="max_sessions" min="1" max="100" placeholder="10"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- BRANDING TAB -->
      <div class="tab-pane" id="tab-branding">
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><circle cx="11" cy="11" r="2"/></svg></span>
            <div><div class="settings-section-title">Site Icon</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Site Icon URL</div><div class="settings-row-desc">PNG/SVG path</div></div>
              <div class="settings-row-control"><input type="text" class="form-control" id="setting_site_icon_url" data-key="site_icon_url" placeholder="/public/images/logo.png"></div>
            </div>
          </div>
        </div>
        <!-- Preview with SVG fallback + dynamic update -->
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg> Preview</div>
          </div>
          <div class="card-body">
            <div style="padding: 20px; background: var(--bg-secondary); border-radius: var(--radius-md); text-align: center;">
              <img id="previewIcon" src="" style="width: 48px; height: 48px; margin-bottom: 10px; border-radius: 8px; object-fit: cover;" onerror="this.style.display='none'; document.getElementById('previewIconFallback').style.display='block';">
              <div style="font-size: 36px; margin-bottom: 10px; display: none; color: var(--accent-primary);" id="previewIconFallback">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </div>
              <div style="font-size: 16px; font-weight: 700;" id="previewTitle">HKVM Panel</div>
              <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;" id="previewDesc">Virtual Machine Management System</div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECURITY TAB -->
      <div class="tab-pane" id="tab-security">
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div><div class="settings-section-title">Security Settings</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Change Admin Password</div><div class="settings-row-desc">Update administrator credentials</div></div>
              <div class="settings-row-control"><button class="btn btn-outline btn-sm" onclick="openModal('changePasswordModal')" style="display: flex; align-items: center; gap: 6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/><path d="M15 5l4 4"/></svg> Change Password</button></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Active Sessions</div><div class="settings-row-desc">View and manage logins</div></div>
              <div class="settings-row-control"><div style="font-size: 13px; color: var(--text-secondary);"><span class="badge-dot"></span>Managed by server</div></div>
            </div>
          </div>
        </div>
        <!-- Security overview with SVG icons -->
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Security Overview</div>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
              <div style="padding: 14px; background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-green);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-green); margin-top: 6px;">Session Auth</div>
                <div style="font-size: 11px; color: var(--text-muted);">bcrypt hashed</div>
              </div>
              <div style="padding: 14px; background: rgba(99, 102, 241, 0.06); border: 1px solid rgba(99, 102, 241, 0.15); border-radius: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-primary);"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/><path d="M15 5l4 4"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-primary); margin-top: 6px;">RBAC Control</div>
                <div style="font-size: 11px; color: var(--text-muted);">Admin/User roles</div>
              </div>
              <div style="padding: 14px; background: rgba(245, 158, 11, 0.06); border: 1px solid rgba(245, 158, 11, 0.15); border-radius: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-orange);"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-orange); margin-top: 6px;">VM Isolation</div>
                <div style="font-size: 11px; color: var(--text-muted);">Only own VMs</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- SYSTEM TAB -->
      <div class="tab-pane" id="tab-system">
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3"/></svg> System Information</div>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
              <div>
                <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 12px;">Panel Info</div>
                <div style="display: grid; gap: 8px;">
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Version</span><span style="font-size: 12px; color: var(--accent-primary); font-weight: 600;">HKVM V1.0.0</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Framework</span><span style="font-size: 12px;">Express.js + EJS</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Database</span><span style="font-size: 12px;">SQLite3</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Hypervisor</span><span style="font-size: 12px;">QEMU/KVM</span></div>
                  <div style="display: flex; justify-content: space-between; padding: 8px 0;"><span style="font-size: 12px; color: var(--text-muted);">Cloud Init</span><span style="color: var(--accent-green);">✅ Supported</span></div>
                </div>
              </div>
              <div>
                <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: var(--text-muted); margin-bottom: 12px;">Live Stats</div>
                <div id="systemLiveStats">
                  <div style="text-align: center; padding: 20px;"><div class="spinner" style="margin: 0 auto;"></div></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <!-- Danger zone with svg -->
        <div class="settings-section" style="margin-top: 20px; border-color: rgba(239, 68, 68, 0.2);">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span>
            <div><div class="settings-section-title" style="color: var(--accent-red);">Danger Zone</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Stop All VMs</div><div class="settings-row-desc">Emergency stop running virtual machines</div></div>
              <div class="settings-row-control"><button class="btn btn-danger btn-sm" onclick="stopAllVMs()" style="display: flex; align-items: center; gap: 6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Stop All</button></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ABOUT TAB with svg dynamic -->
      <div class="tab-pane" id="tab-about">
        <div class="card">
          <div class="card-body" style="text-align: center; padding: 40px;">
            <div style="font-size: 72px; margin-bottom: 20px; color: var(--accent-primary); animation: float 3s ease-in-out infinite;">
              <svg width="70" height="70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <div style="font-size: 28px; font-weight: 800;">HKVM Panel</div>
            <div style="font-size: 14px; color: var(--text-muted);">Professional VM Management Platform</div>
            <div style="font-size: 13px; color: var(--accent-primary); font-weight: 600; margin-bottom: 24px;"><%= panelVersion %></div>
            <div style="max-width: 500px; margin: 0 auto 28px; font-size: 13px; color: var(--text-muted); line-height: 1.7;">QEMU/KVM platform with cloud-init, monitoring and multi-user access.</div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; max-width: 500px; margin: 0 auto 28px;">
              <div style="padding: 14px; background: rgba(99,102,241,0.06); border-radius: 10px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg><div style="font-size: 11px; margin-top: 6px;">VM Mgmt</div></div>
              <div style="padding: 14px; background: rgba(16,185,129,0.06); border-radius: 10px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17.5 19a4.5 4.5 0 1 0-4.5-4.5"/><path d="M20 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h2"/><path d="M16 9h2"/></svg><div style="font-size: 11px;">Cloud Init</div></div>
              <div style="padding: 14px; background: rgba(245,158,11,0.06); border-radius: 10px;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><div style="font-size: 11px;">RBAC</div></div>
            </div>
            <div style="font-size: 12px; color: var(--text-muted);">&copy; 2026 HopingBoyz · Built with ❤️</div>
          </div>
        </div>
      </div>
    </div>
    <%- include('../partials/admin/footer') %>
  </div>
</div>

<!-- MODAL with svg icon -->
<div class="modal-overlay" id="changePasswordModal">
  <div class="modal">
    <div class="modal-header">
      <div class="modal-title" style="display: flex; align-items: center; gap: 8px;"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/></svg> Change Password</div>
      <button class="modal-close" onclick="closeModal('changePasswordModal')"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
    <div class="modal-body">
      <div id="pwChangeAlert" style="display: none; margin-bottom: 14px;"></div>
      <div class="form-group"><label class="form-label">New Password</label><input type="password" class="form-control" id="newPw" placeholder="Min 8 characters"></div>
      <div class="form-group" style="margin-bottom: 0;"><label class="form-label">Confirm Password</label><input type="password" class="form-control" id="confirmPw" placeholder="Repeat password"></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-ghost" onclick="closeModal('changePasswordModal')">Cancel</button>
      <button class="btn btn-primary" onclick="changePassword()">Update Password</button>
    </div>
  </div>
</div>

<script>
(function() {
  // Prevent duplicate id issue: we have two site_icon_url inputs, so we querySelector the active tab input.
  function getIconUrlInputs() {
    return Array.from(document.querySelectorAll('[data-key="site_icon_url"]'));
  }

  // Tab switching
  window.switchTab = function(tab) {
    document.querySelectorAll('.tab-btn').forEach((btn, idx) => {
      const tabs = ['general', 'branding', 'security', 'system', 'about'];
      btn.classList.toggle('active', tabs[idx] === tab);
    });
    document.querySelectorAll('.tab-pane').forEach(pane => {
      pane.classList.toggle('active', pane.id === `tab-${tab}`);
    });
    if (tab === 'system') loadSystemStats();
  };

  // Load settings
  async function loadSettings() {
    try {
      const res = await fetch('/api/settings');
      if (!res.ok) return;
      const settings = await res.json();
      Object.entries(settings).forEach(([key, value]) => {
        const els = document.querySelectorAll(`[data-key="${key}"]`);
        els.forEach(el => { if (el) el.value = value || ''; });
      });
      updateBrandPreview();
    } catch(e) {}
  }

  window.updateBrandPreview = function() {
    const siteName = document.getElementById('setting_site_name')?.value || 'HKVM Panel';
    const siteDesc = document.getElementById('setting_site_description')?.value || 'Virtual Machine Management System';
    const iconInputs = getIconUrlInputs();
    const siteIconUrl = (iconInputs[0] && iconInputs[0].value) || (iconInputs[1] && iconInputs[1].value) || '';
    
    const pi = document.getElementById('previewIcon');
    const pif = document.getElementById('previewIconFallback');
    const pt = document.getElementById('previewTitle');
    const pd = document.getElementById('previewDesc');
    
    if (siteIconUrl) {
      if (pi) { pi.src = siteIconUrl; pi.style.display = 'block'; }
      if (pif) pif.style.display = 'none';
    } else {
      if (pi) pi.style.display = 'none';
      if (pif) pif.style.display = 'block';
    }
    if (pt) pt.textContent = siteName;
    if (pd) pd.textContent = siteDesc;
    
    const panelTitle = document.getElementById('setting_panel_title')?.value;
    const panelDesc = document.getElementById('setting_panel_description')?.value;
    if (!document.getElementById('setting_site_name')?.value && panelTitle && pt) pt.textContent = panelTitle;
    if (!document.getElementById('setting_site_description')?.value && panelDesc && pd) pd.textContent = panelDesc;
  };

  // listeners on all relevant inputs
  document.addEventListener('DOMContentLoaded', () => {
    ['setting_site_name', 'setting_site_description', 'setting_site_icon_url', 'setting_panel_title', 'setting_panel_description'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', updateBrandPreview);
    });
    // also listen to duplicated site_icon_url
    const iconEls = getIconUrlInputs();
    iconEls.forEach(el => el?.addEventListener('input', updateBrandPreview));
    loadSettings();
  });

  window.saveAllSettings = async function() {
    const settings = {};
    document.querySelectorAll('[data-key]').forEach(el => {
      const key = el.getAttribute('data-key');
      if (key && el.value) settings[key] = el.value;
    });
    const alert = document.getElementById('settingsAlert');
    try {
      const res = await fetch('/api/settings', { method: 'PUT', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(settings) });
      const data = await res.json();
      if (res.ok && data.success) {
        alert.className = 'alert alert-success';
        alert.innerHTML = `<span class="alert-icon">✅</span><span>Settings saved (${data.saved})</span>`;
        alert.style.display = 'flex';
        if (window.showToast) showToast('Settings saved', 'success');
      } else throw new Error(data.errors ? data.errors.map(e=>e.error).join(', ') : 'Save failed');
    } catch(e) {
      alert.className = 'alert alert-error';
      alert.innerHTML = `<span class="alert-icon">❌</span><span>${e.message}</span>`;
      alert.style.display = 'flex';
      if (window.showToast) showToast('Failed: ' + e.message, 'error');
    }
    setTimeout(() => alert.style.display = 'none', 4000);
  };

  window.loadSystemStats = async function() {
    const el = document.getElementById('systemLiveStats');
    if (!el) return;
    try {
      const res = await fetch('/api/vms');
      const vms = res.ok ? await res.json() : [];
      const running = vms.filter(v => v.status === 'running').length;
      el.innerHTML = `
        <div style="display: grid; gap: 8px;">
          <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Total VMs</span><span style="font-weight: 600;">${vms.length}</span></div>
          <div style="display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);"><span style="font-size: 12px; color: var(--text-muted);">Running VMs</span><span style="color: var(--accent-green); font-weight: 600;">${running}</span></div>
          <div style="display: flex; justify-content: space-between; padding: 8px 0;"><span style="font-size: 12px; color: var(--text-muted);">Panel Status</span><span style="color: var(--accent-green);">🟢 Online</span></div>
        </div>`;
    } catch(e) {
      el.innerHTML = `<div style="color: var(--text-muted); font-size: 12px;">Could not load stats</div>`;
    }
  };

  window.stopAllVMs = async function() {
    if (window.confirmAction) {
      const confirmed = await confirmAction('Force stop ALL running VMs?', '⚠️ Stop All VMs');
      if (!confirmed) return;
    } else {
      if (!confirm('Stop all running VMs?')) return;
    }
    try {
      const res = await fetch('/api/vms');
      const vms = await res.json();
      const running = vms.filter(v => v.status === 'running');
      if (running.length === 0) { if (window.showToast) showToast('No running VMs', 'info'); return; }
      let stopped = 0;
      for (const vm of running) { try { await fetch(`/api/vms/${vm.vm_id}/stop`, {method:'POST'}); stopped++; } catch(e){} }
      if (window.showToast) showToast(`Stopped ${stopped} VM(s)`, 'success');
    } catch(e) { if (window.showToast) showToast('Error: ' + e.message, 'error'); }
  };

  window.changePassword = function() {
    const pw = document.getElementById('newPw')?.value;
    const confirm = document.getElementById('confirmPw')?.value;
    const alert = document.getElementById('pwChangeAlert');
    if (!pw || pw.length < 8) {
      alert.className = 'alert alert-error'; alert.innerHTML = '<span>❌ Min 8 characters</span>'; alert.style.display = 'flex'; return;
    }
    if (pw !== confirm) {
      alert.className = 'alert alert-error'; alert.innerHTML = '<span>❌ Passwords do not match</span>'; alert.style.display = 'flex'; return;
    }
    alert.className = 'alert alert-info'; alert.innerHTML = '<span>ℹ️ API endpoint required</span>'; alert.style.display = 'flex';
  };

  // modal helpers if not defined
  if (!window.openModal) window.openModal = (id) => document.getElementById(id)?.classList.add('active');
  if (!window.closeModal) window.closeModal = (id) => document.getElementById(id)?.classList.remove('active');
})();
</script>
</body>
</html>