<script>
function formatMem(mem) {
  if (!mem) return '—';
  return mem >= 1024 ? (mem / 1024).toFixed(1) + ' GB' : mem + ' MB';
}

function formatTime() {
  const d = new Date();
  return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
}

function escHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

// ============ TOAST SYSTEM ============
function showToast(msg, type = 'info') {
  const container = document.getElementById('toastContainer') || createToastContainer();
  const iconMap = { success: 'i-check', error: 'i-x', warning: 'i-alert', info: 'i-info' };
  
  const toast = document.createElement('div');
  toast.className = `toast toast-${type}`;
  toast.innerHTML = `
    <span class="toast-icon"><svg class="icon" style="width:18px;height:18px"><use href="#${iconMap[type] || 'i-info'}"/></svg></span>
    <span class="toast-message">${escHtml(msg)}</span>
    <button class="toast-close" onclick="this.parentElement.remove()">×</button>
  `;
  container.appendChild(toast);
  
  setTimeout(() => {
    toast.classList.add('removing');
    setTimeout(() => toast.remove(), 300);
  }, 4000);
}

function createToastContainer() {
  const container = document.createElement('div');
  container.id = 'toastContainer';
  container.className = 'toast-container';
  document.body.appendChild(container);
  return container;
}

// ============ CONFIRMATION MODAL ============
function confirmAction(msg, title) {
  return new Promise((resolve) => {
    const overlay = document.createElement('div');
    overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.75);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(8px);';
    
    const modal = document.createElement('div');
    modal.style.cssText = 'background:var(--bg-card);border:1px solid var(--border-card);border-radius:14px;width:100%;max-width:450px;box-shadow:0 20px 60px rgba(0,0,0,0.6);animation:slideInModal 0.3s ease-out;overflow:hidden;';
    
    modal.innerHTML = `
      <div style="padding:20px 22px 14px;border-bottom:1px solid var(--border-subtle);display:flex;align-items:center;gap:12px;">
        <div style="width:38px;height:38px;background:rgba(245,158,11,0.15);border-radius:10px;display:flex;align-items:center;justify-content:center;color:#F59E0B;">
          <svg class="icon" style="width:20px;height:20px;"><use href="#i-alert"/></svg>
        </div>
        <h2 style="margin:0;color:var(--text-primary);font-size:16px;font-weight:700;">${escHtml(title)}</h2>
      </div>
      <div style="padding:20px 22px;">
        <p style="margin:0;color:var(--text-secondary);font-size:14px;line-height:1.5;">${escHtml(msg)}</p>
      </div>
      <div style="padding:14px 22px 18px;border-top:1px solid var(--border-subtle);display:flex;gap:10px;justify-content:flex-end;">
        <button id="cancelBtn" style="padding:9px 18px;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px;background:transparent;color:var(--text-secondary);border:1px solid var(--border-color);">Cancel</button>
        <button id="confirmBtn" style="padding:9px 18px;border-radius:8px;cursor:pointer;border:none;font-weight:600;font-size:13px;background:linear-gradient(135deg, var(--color-amber), var(--color-orange));color:var(--text-primary);box-shadow:0 4px 12px var(--color-amber-light);">Confirm</button>
      </div>
    `;
    
    overlay.appendChild(modal);
    document.body.appendChild(overlay);
    
    const cleanup = () => overlay.remove();
    modal.querySelector('#confirmBtn').onclick = () => { cleanup(); resolve(true); };
    modal.querySelector('#cancelBtn').onclick = () => { cleanup(); resolve(false); };
    overlay.onclick = (e) => { if (e.target === overlay) { cleanup(); resolve(false); } };
    document.addEventListener('keydown', function esc(e) {
      if (e.key === 'Escape') { cleanup(); resolve(false); document.removeEventListener('keydown', esc); }
    });
  });
}

// ============ VM ACTIONS ============
async function vmAction(action, vmId, vmName) {
  const confirmed = await confirmAction(
    `Are you sure you want to ${action} VM "${vmName}"?`,
    action.charAt(0).toUpperCase() + action.slice(1) + ' Virtual Machine'
  );
  if (!confirmed) return;
  
  try {
    showToast(`${action.charAt(0).toUpperCase() + action.slice(1)}ing VM...`, 'info');
    const res = await fetch(`/api/vms/${vmId}/${action}`, { method: 'POST' });
    const data = await res.json();
    if (res.ok && data.success) {
      showToast(`VM ${action}ed successfully`, 'success');
      setTimeout(loadAdminData, 1200);
    } else {
      showToast(`Failed: ${data.error || 'Unknown error'}`, 'error');
    }
  } catch(e) {
    showToast('Error: ' + e.message, 'error');
  }
}

// ============ ANIMATE NUMBER ============
function animateNumber(id, target) {
  const el = document.getElementById(id);
  if (!el) return;
  const current = parseInt(el.textContent) || 0;
  const duration = 600;
  const start = performance.now();
  function step(now) {
    const p = Math.min((now - start) / duration, 1);
    const eased = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.round(current + (target - current) * eased);
    if (p < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

// ============ RENDER VM CARD (Admin) ============
function renderVMCard(vm) {
  const icon = vm.template_icon;
  const displayIcon = (icon && icon.startsWith('http')) ? icon : 'https://i.imgur.com/wu0Ob6B.png';
  const status = vm.status || 'stopped';
  const ownerName = vm.owner_username || 'Unassigned';
  
  return `
    <div class="vm-card-enhanced ${status}">
      <div class="vm-card-header">
        <div class="vm-title-block">
          <div class="vm-os-icon">
            <img src="${displayIcon}" alt="${escHtml(vm.template_name || 'OS')}" onerror="this.src='https://i.imgur.com/wu0Ob6B.png'">
          </div>
          <div style="min-width: 0; flex: 1;">
            <div class="vm-name-enhanced">${escHtml(vm.vm_name)}</div>
            <div class="vm-meta-enhanced">
              <span>${escHtml(vm.template_name || vm.os_type || 'Custom OS')}</span>
              <span class="vm-owner-tag">👤 ${escHtml(ownerName)}</span>
              <span class="vm-id-chip">#${vm.vm_id}</span>
            </div>
          </div>
        </div>
        <span class="status-badge ${status}">
          <span class="status-dot"></span>${status}
        </span>
      </div>

      <div class="vm-specs">
        <div class="spec-item">
          <div class="spec-icon mem"><svg class="icon"><use href="#i-mem"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Memory</div>
            <div class="spec-value">${vm.memory ? vm.memory + ' MB' : '—'}</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon cpu"><svg class="icon"><use href="#i-cpu"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">vCPUs</div>
            <div class="spec-value">${vm.cpus || '—'} Cores</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon disk"><svg class="icon"><use href="#i-disk"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Storage</div>
            <div class="spec-value">${vm.disk_size || '—'}</div>
          </div>
        </div>
        <div class="spec-item">
          <div class="spec-icon net"><svg class="icon"><use href="#i-network"/></svg></div>
          <div class="spec-content">
            <div class="spec-label">Network</div>
            <div class="spec-value">${vm.ipv4_address || 'DHCP'}</div>
          </div>
        </div>
      </div>

      <div class="vm-actions-enhanced">
        ${status === 'stopped'
          ? `<button class="btn-action start" onclick="vmAction('start', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
              <svg class="icon"><use href="#i-play"/></svg> Start
            </button>`
          : `<button class="btn-action stop" onclick="vmAction('stop', ${vm.vm_id}, '${escHtml(vm.vm_name)}')">
              <svg class="icon"><use href="#i-stop"/></svg> Stop
            </button>`
        }
        <a href="/admin/vm/${vm.vm_id}" class="btn-action primary">
          <svg class="icon"><use href="#i-info"/></svg> Details
        </a>
        <a href="/admin/vm/${vm.vm_id}/console" class="btn-action">
          <svg class="icon"><use href="#i-terminal"/></svg> Console
        </a>
      </div>
    </div>
  `;
}

// ============ LOAD ADMIN DATA ============
async function loadAdminData() {
  const btn = document.getElementById('refreshBtn');
  if (btn) btn.classList.add('spinning');
  
  try {
    // Fetch admin dashboard stats
    const statsRes = await fetch('/api/admin/dashboard');
    if (statsRes.ok) {
      const stats = await statsRes.json();
      animateNumber('totalVMs', stats.totalVMs || 0);
      animateNumber('runningVMs', stats.runningVMs || 0);
      animateNumber('stoppedVMs', (stats.totalVMs || 0) - (stats.runningVMs || 0));
      animateNumber('totalUsers', stats.totalUsers || 0);
      document.getElementById('statusTotalVMs').textContent = stats.totalVMs || 0;
    }

    // Fetch all VMs
    const vmsRes = await fetch('/api/admin/vms');
    if (!vmsRes.ok) throw new Error('Failed to load VMs');
    const vms = await vmsRes.json();
    
    document.getElementById('vmCount').textContent = vms.length;
    document.getElementById('lastUpdate').textContent = `· Updated ${formatTime()}`;
    
    const container = document.getElementById('allVMContainer');
    
    if (vms.length === 0) {
      container.innerHTML = `
        <div class="empty-enhanced">
          <div class="empty-icon-wrap"><svg class="icon"><use href="#i-server"/></svg></div>
          <div class="empty-title">No Virtual Machines</div>
          <div class="empty-desc">Get started by creating your first virtual machine.</div>
          <a href="/admin/vm-create" class="btn-refresh" style="background: linear-gradient(135deg, var(--color-indigo), var(--color-violet)); color: var(--text-primary); border-color: transparent;">
            <svg class="icon"><use href="#i-plus"/></svg> Create VM
          </a>
        </div>`;
      return;
    }
    
    container.innerHTML = `
      <div class="vm-grid">
        ${vms.map(vm => renderVMCard(vm)).join('')}
      </div>`;
      
  } catch(e) {
    document.getElementById('allVMContainer').innerHTML = `
      <div class="empty-enhanced">
        <div class="empty-icon-wrap" style="color: var(--color-red); background: linear-gradient(135deg, var(--color-red-light), rgba(239,68,68,0.05));">
          <svg class="icon"><use href="#i-alert"/></svg>
        </div>
        <div class="empty-title">Failed to Load VMs</div>
        <div class="empty-desc">${escHtml(e.message)}</div>
        <button class="btn-refresh" onclick="loadAdminData()">
          <svg class="icon"><use href="#i-refresh"/></svg> Try Again
        </button>
      </div>`;
  } finally {
    if (btn) setTimeout(() => btn.classList.remove('spinning'), 500);
  }

  // Load recent activity
  loadRecentActivity();
}

// ============ LOAD RECENT ACTIVITY ============
async function loadRecentActivity() {
  try {
    // Try to fetch recent logs from all VMs
    const res = await fetch('/api/admin/activity?limit=10');
    if (res.ok) {
      const activities = await res.json();
      const container = document.getElementById('activityList');
      document.getElementById('activityCount').textContent = activities.length;
      
      if (activities.length === 0) {
        container.innerHTML = `
          <div style="text-align: center; color: var(--text-muted); padding: 30px 0; font-size: 13px;">
            No recent activity
          </div>`;
        return;
      }
      
      const iconMap = {
        'start': 'start',
        'stop': 'stop',
        'create': 'create',
        'delete': 'delete',
        'edit': 'edit',
        'login': 'login'
      };
      
      container.innerHTML = activities.map(act => {
        const iconType = iconMap[act.action] || 'edit';
        return `
          <div class="activity-item">
            <div class="activity-icon ${iconType}">
              <svg class="icon"><use href="#i-${act.action === 'start' ? 'play' : act.action === 'stop' ? 'stop' : act.action === 'create' ? 'plus' : act.action === 'delete' ? 'x' : act.action === 'login' ? 'users' : 'info'}"/></svg>
            </div>
            <div class="activity-content">
              <div class="title">${escHtml(act.message || act.action)}</div>
              <div class="desc">VM #${act.vm_id} · ${escHtml(act.status || '')}</div>
            </div>
            <div class="activity-time">${act.timestamp ? new Date(act.timestamp).toLocaleTimeString() : ''}</div>
          </div>
        `;
      }).join('');
    } else {
      // Fallback: show some mock activities or empty state
      document.getElementById('activityList').innerHTML = `
        <div style="text-align: center; color: var(--text-muted); padding: 20px 0; font-size: 13px;">
          Activity feed unavailable
        </div>`;
    }
  } catch(e) {
    // Silent fail for activity
    document.getElementById('activityList').innerHTML = `
      <div style="text-align: center; color: var(--text-muted); padding: 20px 0; font-size: 13px;">
        No recent activity
      </div>`;
  }
}

// ============ SYSTEM STATUS ============
async function loadSystemStatus() {
  try {
    // Fetch system info
    const res = await fetch('/api/system/status');
    if (res.ok) {
      const data = await res.json();
      if (data.cpu) document.getElementById('statusCpu').textContent = data.cpu;
      if (data.memory) document.getElementById('statusMemory').textContent = data.memory;
    }
  } catch(e) {
    // Silent fail
  }
}

// ============ INITIAL LOAD ============
loadAdminData();
loadSystemStatus();
setInterval(loadAdminData, 30000);
setInterval(loadSystemStatus, 60000);
</script>
