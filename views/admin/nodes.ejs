<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Nodes - HKVM Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>
  <div class="admin-main">
    <%- include('../partials/admin/header') %>
    <div class="admin-content" id="pageContent">
      <div style="text-align:center;padding:80px;"><div class="spinner spinner-lg" style="margin:0 auto 16px;"></div><div style="color:var(--text-muted);">Loading nodes...</div></div>
    </div>
    <%- include('../partials/admin/footer') %>
  </div>
</div>
<script>
function svg(id,s=14){return `<svg width="${s}" height="${s}"><use href="#${id}"/></svg>`;}

async function loadPage(){
  try{
    const[nodesRes,healthRes]=await Promise.all([fetch('/api/nodes'),fetch('/api/admin/dashboard').catch(()=>null)]);
    const nodes=await nodesRes.json();
    renderPage(nodes);
  }catch(e){document.getElementById('pageContent').innerHTML=`<div class="empty-state"><div class="empty-state-title">Error Loading Nodes</div><div class="empty-state-desc">${e.message}</div></div>`;}
}

function renderPage(nodes){
  const online=nodes.filter(n=>n.status==='online').length;
  const offline=nodes.filter(n=>n.status==='offline').length;
  const maintenance=nodes.filter(n=>n.status==='maintenance').length;

  document.getElementById('pageContent').innerHTML=`
    <div class="page-header"><h1 class="page-title">${svg('i-server',18)} Nodes</h1>
      <div class="page-actions"><a href="/admin/nodes/create" class="btn btn-primary">${svg('i-plus',13)} Add Node</a></div>
    </div>
    <div class="stats-grid" style="margin-bottom:20px;">
      <div class="stat-card" style="padding:16px;"><div style="font-size:24px;font-weight:800;color:var(--text-primary);">${nodes.length}</div><div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;">Total Nodes</div></div>
      <div class="stat-card" style="padding:16px;"><div style="font-size:24px;font-weight:800;color:#10B981;">${online}</div><div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;">Online</div></div>
      <div class="stat-card" style="padding:16px;"><div style="font-size:24px;font-weight:800;color:#EF4444;">${offline}</div><div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;">Offline</div></div>
      <div class="stat-card" style="padding:16px;"><div style="font-size:24px;font-weight:800;color:#F59E0B;">${maintenance}</div><div style="font-size:11px;color:var(--text-muted);text-transform:uppercase;">Maintenance</div></div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:16px;">
      ${nodes.map(n=>`
        <div class="card" style="padding:20px;">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
            <div style="display:flex;align-items:center;gap:10px;">
              <div style="width:40px;height:40px;border-radius:10px;background:${n.status==='online'?'rgba(16,185,129,0.12)':'rgba(239,68,68,0.12)'};color:${n.status==='online'?'#10B981':'#EF4444'};display:flex;align-items:center;justify-content:center;">${svg('i-server',20)}</div>
              <div><div style="font-weight:700;font-size:14px;">${n.name}</div><div style="font-size:11px;color:var(--text-muted);">${n.location||n.hostname}</div></div>
            </div>
            <span class="badge ${n.status==='online'?'badge-running':n.status==='maintenance'?'badge-pending':'badge-stopped'}"><span class="dot"></span> ${n.status||'unknown'}</span>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-size:12px;color:var(--text-muted);margin-bottom:12px;">
            <div>Type: <strong style="color:var(--text-primary);">${n.api_type||'proxmox'}</strong></div>
            <div>Priority: <strong style="color:var(--text-primary);">${n.priority||5}</strong></div>
          </div>
          <div style="display:flex;gap:8px;">
            <a href="/admin/nodes/${n.id}" class="btn btn-outline btn-sm" style="flex:1;justify-content:center;">${svg('i-info',13)} Details</a>
            <button class="btn btn-ghost btn-sm" onclick="testNode(${n.id})" style="flex:1;justify-content:center;">${svg('i-check',13)} Test</button>
          </div>
        </div>
      `).join('')}
      ${nodes.length===0?'<div style="grid-column:1/-1;text-align:center;padding:60px;color:var(--text-muted);"><div style="font-size:48px;margin-bottom:16px;">🖥️</div><div style="font-size:16px;font-weight:600;margin-bottom:8px;">No Nodes Configured</div><div style="font-size:13px;margin-bottom:20px;">Add a Proxmox node to start managing containers</div><a href="/admin/nodes/create" class="btn btn-primary">Add First Node</a></div>':''}
    </div>`;
}

async function testNode(id){
  try{
    const res=await fetch(`/api/nodes/${id}/test`,{method:'POST'});
    const data=await res.json();
    if(data.success) showToast(`Connection successful! Version: ${data.version}`,'success');
    else showToast(`Connection failed: ${data.error}`,'error');
  }catch(e){showToast(e.message,'error');}
}

loadPage();
</script>
</body>
</html>
